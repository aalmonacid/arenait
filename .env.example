SANITY_PROJECT_ID=xbayv7k2
SANITY_DATASET=production
SANITY_API_VERSION=2024-01-01
SANITY_USE_CDN=false
# SANITY_API_TOKEN=your_token_here

# Token de escritura de Sanity (permiso "Editor" o superior), usado por
# src/pages/api/leads.ts para guardar leads del formulario de contacto.
# Generarlo en https://www.sanity.io/manage -> proyecto xbayv7k2 -> API -> Tokens.
# Nunca prefijar con PUBLIC_: debe permanecer server-side únicamente.
# También debe configurarse como variable de entorno en Cloudflare para producción.
SANITY_API_WRITE_TOKEN=your_write_token_here

# --- Variables de lanzamiento (configurar en Cloudflare, ver PLAN-PRODUCCION.md) ---

# Aviso opcional de lead nuevo a un webhook entrante (Slack, Teams, Make, Zapier).
# Solo envía empresa, servicio y enlace al Studio (sin datos personales).
# LEAD_NOTIFY_WEBHOOK_URL=

# Poner en 'true' SOLO en el entorno de producción cuando se autorice el lanzamiento:
# quita la etiqueta noindex y abre robots.txt. En dev/preview debe quedar sin definir.
# PUBLIC_ALLOW_INDEXING=true

# Dominio canónico del sitio (sitemap, canonical, Open Graph). Por defecto https://arenait.co.
# PUBLIC_SITE_URL=https://arenait.co

# --- Formulario de contacto: captcha y correo (ver GUIA-HABILITACION.md, pasos 7 y 8) ---

# Captcha Cloudflare Turnstile. Se configuran las DOS juntas; sin ellas no hay captcha.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Correo con Resend. Sin RESEND_API_KEY y MAIL_FROM no se envía nada.
# RESEND_API_KEY=
# MAIL_FROM=ArenaIT <contacto@arenait.co>
# MAIL_TO_OWNER=
