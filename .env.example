SANITY_DATASET=production
SANITY_API_VERSION=2024-01-01
SANITY_USE_CDN=false
# SANITY_API_TOKEN=your_token_here

# Token de escritura de Sanity (permiso "Editor" o superior), usado por
# src/pages/api/leads.ts para guardar leads del formulario de contacto.
# Generarlo en https://www.sanity.io/manage -> proyecto xbayv7k2 -> API -> Tokens.
# Nunca prefijar con PUBLIC_: debe permanecer server-side únicamente.
# También debe configurarse como variable de entorno en Vercel para producción.
SANITY_API_WRITE_TOKEN=your_write_token_here
