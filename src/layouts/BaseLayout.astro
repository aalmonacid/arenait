---
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import CookieConsentBanner from '../components/CookieConsentBanner.astro';

interface Props {
  title: string;
  description?: string;
  structuredData?: Record<string, unknown>[];
  ogImage?: string;
}

const {
  title,
  description = 'Desarrollo de software a la medida para operaciones reales.',
  ogImage = '/og-default.png',
} = Astro.props;

const absoluteOgImage = new URL(ogImage, Astro.site).toString();

const structuredData: Record<string, unknown>[] = Astro.props.structuredData ?? [];

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'ArenaIT',
  url: 'https://arenait.co',
  description: 'Desarrollo de software a la medida para operaciones reales.',
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | ArenaIT</title>
    <meta name="description" content={description} />

    <!-- OpenGraph -->
    <meta property="og:title" content={`${title} | ArenaIT`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={absoluteOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Fallback tipográfico: Codec Pro es una fuente comercial sin archivos
         licenciados en este repo (ver public/fonts/ en CONTEXT.md §5). Hasta
         que se suban esos .woff2, el sitio debe cargar explícitamente su
         fallback declarado (Plus Jakarta Sans) en vez de caer a sans-serif
         genérica del sistema. Cargado de forma no bloqueante (preload +
         inyección por script externo, en vez de un <link rel="stylesheet">
         directo): un <link> síncrono en <head> bloquea el parseo/renderizado
         hasta que Google Fonts responde, y si ese dominio es lento o
         inalcanzable (red restringida, tercero caído) cuelga la carga de
         toda la página — se confirmó este colgado en un entorno de red
         restringida durante el smoke testing con Playwright. El script vive
         en /public/scripts/font-loader.js (no inline aquí) porque la CSP
         del sitio bloquea scripts inline en producción — ver CONTEXT.md §5. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;700;800&display=swap"
    />
    <script src="/scripts/font-loader.js" is:inline></script>
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;700;800&display=swap"
      />
    </noscript>

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | ArenaIT`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteOgImage} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    {
      structuredData.map((schema) => (
        <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
      ))
    }
  </head>
  <body class="min-h-screen flex flex-col">
    <header class="bg-white border-b-2 border-neutral-200 py-6 px-4 md:px-8">
      <div class="max-w-7xl mx-auto flex justify-between items-center">
        <Logo variant="light" size="header" />
        <nav class="hidden md:flex items-center space-x-8">
          <a
            href="/servicios"
            class="text-sm font-bold tracking-widest uppercase text-neutral-900 hover:text-interactive transition-colors"
            >Servicios</a
          >
          <a
            href="/casos-de-estudio"
            class="text-sm font-bold tracking-widest uppercase text-neutral-900 hover:text-interactive transition-colors"
            >Casos de Estudio</a
          >
          <a
            href="/nosotros"
            class="text-sm font-bold tracking-widest uppercase text-neutral-900 hover:text-interactive transition-colors"
            >Nosotros</a
          >
          <a
            href="/contacto"
            class="text-sm font-bold tracking-widest uppercase text-neutral-900 hover:text-interactive transition-colors"
            >Contacto</a
          >
          <a
            href="/politica-de-tratamiento-de-datos"
            class="text-xs font-medium normal-case text-neutral-400 hover:text-interactive transition-colors border-l border-neutral-200 pl-8"
            >Política de datos</a
          >
        </nav>
      </div>
    </header>

    <main class="flex-grow">
      <slot />
    </main>

    <footer class="bg-secondary text-white py-12 px-4 md:px-8">
      <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-8">
        <div>
          <Logo variant="dark" size="footer" link={false} class="mb-4" />
          <p class="text-neutral-200 max-w-md">Arena IT — Desarrollo de software a la medida.</p>
        </div>
        <nav class="flex flex-col gap-2 text-left md:text-right">
          <a href="/servicios" class="text-neutral-200 hover:text-white transition-colors"
            >Servicios</a
          >
          <a href="/casos-de-estudio" class="text-neutral-200 hover:text-white transition-colors"
            >Casos de estudio</a
          >
          <a href="/nosotros" class="text-neutral-200 hover:text-white transition-colors"
            >Nosotros</a
          >
          <a href="/contacto" class="text-neutral-200 hover:text-white transition-colors"
            >Contacto</a
          >
        </nav>
      </div>
      <div class="max-w-7xl mx-auto mt-12 pt-8 border-t border-neutral-800 text-sm text-neutral-400 flex flex-col md:flex-row md:items-center md:justify-between gap-2">
        <p>&copy; {new Date().getFullYear()} Arena IT. Todos los derechos reservados.</p>
        <a href="/politica-de-tratamiento-de-datos" class="hover:text-white transition-colors">
          Política de Tratamiento de Datos Personales
        </a>
      </div>
    </footer>

    <WhatsAppButton />
    <CookieConsentBanner />
  </body>
</html>
