---
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import Button from '../components/Button.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import CookieConsentBanner from '../components/CookieConsentBanner.astro';
import { getSiteSettings } from '../lib/content';

interface Props {
  title: string;
  description?: string;
  structuredData?: Record<string, unknown>[];
  ogImage?: string;
  /** Fuerza `noindex` aunque el sitio esté abierto a indexación (p. ej. la 404). */
  noindex?: boolean;
  ogType?: 'website' | 'article';
}

// Ajustes del sitio (marca, lema del pie, descripción por defecto): Sanity con respaldo.
const settings = await getSiteSettings();
const siteName = settings.siteName;

const {
  title,
  description = settings.defaultDescription,
  ogImage = '/og-default.png',
  noindex = false,
  ogType = 'website',
} = Astro.props;

const allowIndexing = import.meta.env.PUBLIC_ALLOW_INDEXING === 'true' && !noindex;

const absoluteOgImage = new URL(ogImage, Astro.site).toString();
// Ruta canónica sin barra final ni «.html» (el build genera archivos como contacto.html).
const canonicalPath =
  Astro.url.pathname
    .replace(/(^|\/)index(\.html)?$/, '$1')
    .replace(/\.html$/, '')
    .replace(/(.)\/+$/, '$1') || '/';
const canonicalUrl = new URL(canonicalPath, Astro.site).toString();
const siteOrigin = new URL('/', Astro.site).toString().replace(/\/$/, '');

const structuredData: Record<string, unknown>[] = Astro.props.structuredData ?? [];

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: siteName,
  url: siteOrigin,
  description: settings.defaultDescription,
};

// JSON-LD sin «<»: un valor con «</script>» (por ejemplo, desde Sanity) no
// puede cerrar la etiqueta ni inyectar marcado.
const jsonLd = (data: unknown) => JSON.stringify(data).replace(/</g, '\\u003c');

const NAV_ITEMS = [
  { href: '/servicios', label: 'Servicios' },
  { href: '/proyectos', label: 'Proyectos' },
  { href: '/blog', label: 'Blog' },
  { href: '/nosotros', label: 'Nosotros' },
];
const CTA = { href: '/contacto', label: 'Cuéntanos tu reto' };

const isActive = (href: string) => canonicalPath === href || canonicalPath.startsWith(`${href}/`);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | {siteName}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Indexación controlada por variable de entorno: mientras
         PUBLIC_ALLOW_INDEXING no sea 'true' (dev.arenait.co, previews) el sitio
         se marca noindex. Para el lanzamiento NO hay que tocar código: basta
         definir PUBLIC_ALLOW_INDEXING=true en las variables de compilación de Cloudflare del
         entorno de producción y volver a desplegar. Ver PLAN-PRODUCCION.md.
         Las páginas que reciben `noindex` (404) quedan fuera aunque se lance. -->
    {!allowIndexing && <meta name="robots" content="noindex, nofollow" />}

    <!-- OpenGraph. Las imágenes OG son archivos estáticos 1200x630 en /public. -->
    <meta property="og:title" content={`${title} | ${siteName}`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:image" content={absoluteOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Tipografía: Plus Jakarta Sans, decisión formal del cliente (2026-09-04)
         de usar tipografía libre en vez de licenciar Codec Pro (AGENTS.md).
         Autoalojada desde 12/11/2026 (public/fonts, variable 200-800, licencia OFL):
         elimina la dependencia de Google Fonts (privacidad, un origen menos en la
         CSP) y permite precargar la fuente para que el titular no cambie de
         tipografía después de pintar (CLS medido 0.207 en el home móvil con la
         carga tardía anterior). El @font-face vive en src/styles/global.css. -->
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/plus-jakarta-sans-latin.woff2"
      crossorigin
    />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | ${siteName}`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteOgImage} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <script is:inline type="application/ld+json" set:html={jsonLd(organizationSchema)} />
    {
      structuredData.map((schema) => (
        <script is:inline type="application/ld+json" set:html={jsonLd(schema)} />
      ))
    }
  </head>
  <body class="min-h-screen flex flex-col">
    <!-- Enlace de salto (WCAG 2.4.1): invisible hasta recibir foco con Tab. -->
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[80] focus:bg-accent focus:px-5 focus:py-3 focus:text-sm focus:font-extrabold focus:uppercase focus:tracking-label focus:text-neutral-900 focus:outline focus:outline-4 focus:outline-offset-2 focus:outline-interactive"
      >Saltar al contenido</a
    >

    <!-- El aviso de cookies va al inicio del DOM (no al final): así quien navega con
         teclado o lector de pantalla lo encuentra antes de recorrer toda la página. -->
    <CookieConsentBanner />

    <header class="bg-white border-b-2 border-neutral-200 py-6 px-4 md:px-8">
      <div class="max-w-7xl mx-auto flex justify-between items-center">
        <Logo variant="light" size="header" />
        <!-- El menú de escritorio aparece desde lg (1024 px): entre 768 y 1000 px
             no cabían logo, enlaces y botón en una sola fila. -->
        <nav class="hidden lg:flex items-center gap-8" aria-label="Navegación principal">
          {
            NAV_ITEMS.map((item) => (
              <a
                href={item.href}
                aria-current={isActive(item.href) ? 'page' : undefined}
                class:list={[
                  'text-sm font-bold tracking-widest uppercase text-neutral-900 py-2 border-b-2 transition-colors hover:border-interactive',
                  isActive(item.href) ? 'border-interactive' : 'border-transparent',
                ]}
              >
                {item.label}
              </a>
            ))
          }
          <Button
            href={CTA.href}
            size="sm"
            aria-current={isActive(CTA.href) ? 'page' : undefined}
          >
            {CTA.label}
          </Button>
        </nav>

        <!-- Menú mobile (Épica J). Trigger de 44x44 visible solo debajo de lg;
             el overlay de abajo cubre toda la pantalla (z-70, por encima del
             banner de cookies z-60 y WhatsApp z-50) así que el header original no
             necesita alternar su propio ícono — el botón de cerrar vive dentro
             del overlay. Lógica de apertura/cierre/foco/Escape en
             /public/scripts/mobile-menu.js (nunca inline, ver CONTEXT.md §5). -->
        <button
          id="mobile-menu-trigger"
          type="button"
          class="flex lg:hidden flex-col items-center justify-center gap-[5px] w-11 h-11 rounded-none outline-none focus-visible:outline focus-visible:outline-4 focus-visible:outline-interactive focus-visible:outline-offset-2"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label="Abrir menú"
        >
          <span class="block w-6 h-0.5 bg-neutral-900" aria-hidden="true"></span>
          <span class="block w-6 h-0.5 bg-neutral-900" aria-hidden="true"></span>
          <span class="block w-6 h-0.5 bg-neutral-900" aria-hidden="true"></span>
        </button>
      </div>
    </header>

    <div
      id="mobile-menu"
      class="hidden lg:hidden fixed inset-0 z-[70] flex-col bg-white"
      role="dialog"
      aria-modal="true"
      aria-label="Menú de navegación"
    >
      <div class="flex justify-between items-center px-4 py-6 border-b-2 border-neutral-200">
        <Logo variant="light" size="header" link={false} />
        <button
          id="mobile-menu-close"
          type="button"
          class="relative flex items-center justify-center w-11 h-11 rounded-none outline-none focus-visible:outline focus-visible:outline-4 focus-visible:outline-interactive focus-visible:outline-offset-2"
          aria-label="Cerrar menú"
        >
          <span class="absolute w-[22px] h-0.5 bg-neutral-900 rotate-45" aria-hidden="true"></span>
          <span class="absolute w-[22px] h-0.5 bg-neutral-900 -rotate-45" aria-hidden="true"></span>
        </button>
      </div>
      <nav aria-label="Menú principal" class="flex flex-col overflow-y-auto">
        {
          NAV_ITEMS.map((item) => (
            <a
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class:list={[
                'block px-4 py-5 border-b border-neutral-200 border-l-4 text-xl font-bold tracking-wide uppercase text-neutral-900 transition-colors hover:border-l-interactive outline-none focus-visible:outline focus-visible:outline-2 focus-visible:outline-interactive focus-visible:outline-offset-[-2px]',
                isActive(item.href) ? 'border-l-interactive' : 'border-l-transparent',
              ]}
            >
              {item.label}
            </a>
          ))
        }
        <div class="px-4 py-6">
          <Button
            href={CTA.href}
            class="w-full"
            aria-current={isActive(CTA.href) ? 'page' : undefined}
          >
            {CTA.label}
          </Button>
        </div>
        <a
          href="/politica-de-tratamiento-de-datos"
          class="block px-4 py-4 border-t-2 border-neutral-200 text-sm font-medium text-secondary underline underline-offset-4 decoration-neutral-200 hover:decoration-interactive transition-colors outline-none focus-visible:outline focus-visible:outline-2 focus-visible:outline-interactive focus-visible:outline-offset-[-2px]"
          >Política de datos</a
        >
      </nav>
    </div>

    <main id="main" tabindex="-1" class="flex-grow focus:outline-none">
      <slot />
    </main>

    <footer class="bg-secondary text-white py-12 px-4 md:px-8">
      <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-8">
        <div>
          <Logo variant="dark" size="footer" link={false} class="mb-4" />
          <p class="text-neutral-200 max-w-md">{settings.tagline}</p>
        </div>
        <nav
          class="grid grid-cols-2 gap-x-6 gap-y-1 text-left md:justify-self-end"
          aria-label="Pie de página"
        >
          {
            [...NAV_ITEMS, { href: '/contacto', label: 'Contacto' }].map((item) => (
              <a
                href={item.href}
                class="inline-flex min-h-11 w-fit items-center text-neutral-200 border-b border-transparent hover:text-white hover:border-accent transition-colors focus-visible:outline focus-visible:outline-4 focus-visible:outline-white"
              >
                {item.label}
              </a>
            ))
          }
        </nav>
      </div>
      <!-- Bugfix (auditoría 2026-09-04, Épica K): text-neutral-400 medía ~3.46:1
           contra bg-secondary (#294E6C), falla AA (4.5:1). neutral-400 no está
           definido en tailwind.config.mjs (cae al gris genérico de Tailwind, no un
           token de marca) — se reemplaza por neutral-200, ya en uso en este mismo
           footer para los demás textos secundarios (párrafo de marca, nav),
           medido ~7.10:1 contra #294E6C (relative luminance: L_bg≈0.0700,
           L_neutral-200≈0.8018 ⇒ (0.8018+0.05)/(0.0700+0.05)≈7.10:1) — cumple
           AAA (7:1). El rol "de-enfatizado" se conserva por tamaño (text-sm),
           no por un tono más apagado que ya no cabía dentro de AAA. -->
      <div
        class="max-w-7xl mx-auto mt-12 pt-8 border-t border-white/40 text-sm text-neutral-200 flex flex-col md:flex-row md:items-center md:justify-between gap-2"
      >
        <p>&copy; {new Date().getFullYear()} {siteName}. Todos los derechos reservados.</p>
        <a
          href="/politica-de-tratamiento-de-datos"
          class="inline-flex min-h-11 items-center hover:text-white transition-colors focus-visible:outline-white"
        >
          Política de Tratamiento de Datos Personales
        </a>
      </div>
    </footer>

    <WhatsAppButton />

    <script type="module" src="/scripts/mobile-menu.js" is:inline></script>
  </body>
</html>
