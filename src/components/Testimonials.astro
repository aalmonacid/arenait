---
import { client } from '../lib/sanity';
import type { TestimonialSchema } from '../types/sanity';

let testimonials: TestimonialSchema[] = [];

try {
  testimonials = await client.fetch<TestimonialSchema[]>(`*[_type == "testimonial"]`);
} catch (error) {
  console.error('Error fetching testimonials from Sanity:', error);
}
---

{
  testimonials && testimonials.length > 0 && (
    <section class="py-24 px-4 md:px-8 bg-white border-t border-neutral-200">
      <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {testimonials.map((testimonial) => (
          <blockquote class="border-2 border-neutral-200 p-8 bg-neutral-50">
            <p class="text-neutral-900 leading-relaxed mb-6">“{testimonial.quote}”</p>
            <footer class="text-sm font-bold text-secondary">
              {testimonial.authorName}
              {testimonial.role && (
                <span class="text-neutral-500 font-normal"> — {testimonial.role}</span>
              )}
              {testimonial.company && (
                <span class="text-neutral-500 font-normal">, {testimonial.company}</span>
              )}
            </footer>
          </blockquote>
        ))}
      </div>
    </section>
  )
}
