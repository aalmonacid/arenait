---
/**
 * "Cómo trabajamos" del inicio: las seis fases de una solución (diagnóstico,
 * piloto, desarrollo, QA, implementación, operación), recibidas por prop desde
 * Sanity (o el respaldo). Aquí la numeración SÍ codifica información (es una
 * secuencia real). Es el destino del acceso rápido "Cómo trabajamos".
 *
 * Línea de conexión: horizontal en desktop, vertical en móvil, solo con
 * pseudo-elementos de Tailwind (sin JS). El nodo `highlightIndex` va en accent
 * por eco del punto naranja grande del logo.
 */
import type { TitleText } from '../types/sanity';

interface Props {
  steps: TitleText[];
  /** Posición (desde 0) del nodo resaltado en naranja. */
  highlightIndex?: number;
}

const { steps, highlightIndex = 4 }: Props = Astro.props;
---

<ol
  class="relative grid grid-cols-1 lg:grid-cols-6 gap-8 lg:gap-6 list-none p-0 m-0 before:absolute before:bg-white/40 before:left-5 before:top-0 before:bottom-0 before:w-0.5 lg:before:left-0 lg:before:right-0 lg:before:top-5 lg:before:bottom-auto lg:before:w-auto lg:before:h-0.5"
>
  {
    steps.map((step, i) => (
      <li class="relative pl-16 min-h-10 lg:pl-0 lg:pt-16">
        <span
          class:list={[
            'absolute left-0 top-0 grid h-10 w-10 place-items-center text-base font-extrabold text-neutral-900',
            i === highlightIndex ? 'bg-accent' : 'bg-white',
          ]}
          aria-hidden="true"
        >
          {i + 1}
        </span>
        <h3 class="font-heading text-xl font-extrabold text-white mb-2">{step.title}</h3>
        <p class="text-white leading-relaxed">{step.text}</p>
      </li>
    ))
  }
</ol>
