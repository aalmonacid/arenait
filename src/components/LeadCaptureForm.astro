---
import { POLICY_URL, POLICY_VERSION } from '../lib/legal';

interface Props {
  showServiceDropdown?: boolean;
  services?: { title: string }[];
}

const {
  showServiceDropdown = false,
  services = [
    { title: 'Desarrollo de software a la medida' },
    { title: 'Implementación de aplicaciones' },
    { title: 'Gestión de proyectos de TI' },
    { title: 'Business Intelligence' },
    { title: 'Aseguramiento de la calidad (QA / Testing)' },
    { title: 'Mantenimiento y migración de software' },
  ],
}: Props = Astro.props;

// Clave pública del captcha (Cloudflare Turnstile). Sin ella no se muestra el
// widget y el servidor tampoco exige captcha (ver src/pages/api/leads.ts).
// Se lee TURNSTILE_SITE_KEY (sin prefijo PUBLIC_, que Vercel no deja usar); esta
// página se genera en el servidor/build, así que no necesita llegar al cliente.
// PUBLIC_TURNSTILE_SITE_KEY queda como alternativa por compatibilidad.
const turnstileSiteKey =
  import.meta.env.TURNSTILE_SITE_KEY ??
  process.env.TURNSTILE_SITE_KEY ??
  import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---

<div
  class="bg-white p-8 md:p-12 border border-neutral-200 border-t-4 border-t-neutral-900 font-body"
>
  <h3
    id="formTitle"
    class="text-3xl font-heading font-extrabold mb-8 text-secondary tracking-tight"
  >
    Cuéntanos tu reto
  </h3>

  <form id="leadCaptureForm" class="space-y-6" data-policy-version={POLICY_VERSION}>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div>
        <label
          for="fullName"
          class="block text-xs font-bold tracking-label uppercase mb-2 text-secondary"
          >Nombre Completo</label
        >
        <input
          type="text"
          id="fullName"
          required
          class="w-full rounded-none bg-white border border-secondary px-4 py-3 text-neutral-900 focus:outline-none focus:border-interactive focus:ring-2 focus:ring-interactive transition-colors"
        />
      </div>
      <div>
        <label
          for="company"
          class="block text-xs font-bold tracking-label uppercase mb-2 text-secondary"
          >Empresa</label
        >
        <input
          type="text"
          id="company"
          class="w-full rounded-none bg-white border border-secondary px-4 py-3 text-neutral-900 focus:outline-none focus:border-interactive focus:ring-2 focus:ring-interactive transition-colors"
        />
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div>
        <label
          for="corporateEmail"
          class="block text-xs font-bold tracking-label uppercase mb-2 text-secondary">Correo</label
        >
        <input
          type="email"
          id="corporateEmail"
          required
          placeholder="nombre@empresa.com"
          class="w-full rounded-none bg-white border border-secondary px-4 py-3 text-neutral-900 focus:outline-none focus:border-interactive focus:ring-2 focus:ring-interactive transition-colors"
        />
        <p id="emailError" class="text-sm text-red-800 font-bold mt-2 hidden">
          Por favor, ingrese un correo válido.
        </p>
      </div>
      <div>
        <label
          for="phone"
          class="block text-xs font-bold tracking-label uppercase mb-2 text-secondary"
          >Teléfono (opcional)</label
        >
        <input
          type="tel"
          id="phone"
          class="w-full rounded-none bg-white border border-secondary px-4 py-3 text-neutral-900 focus:outline-none focus:border-interactive focus:ring-2 focus:ring-interactive transition-colors"
        />
      </div>
    </div>

    {
      showServiceDropdown && (
        <div>
          <label
            for="serviceOfInterest"
            class="block text-xs font-bold tracking-label uppercase mb-2 text-secondary"
          >
            Servicio de interés
          </label>
          <select
            id="serviceOfInterest"
            class="w-full rounded-none bg-white border border-secondary px-4 py-3 text-neutral-900 focus:outline-none focus:border-interactive focus:ring-2 focus:ring-interactive transition-colors"
          >
            <option value="" selected>
              Seleccione un servicio...
            </option>
            {services.map((service) => (
              <option value={service.title}>{service.title}</option>
            ))}
          </select>
        </div>
      )
    }

    <div>
      <label
        for="message"
        class="block text-xs font-bold tracking-label uppercase mb-2 text-secondary"
        >Cuéntanos tu reto</label
      >
      <textarea
        id="message"
        rows="4"
        required
        class="w-full rounded-none bg-white border border-secondary px-4 py-3 text-neutral-900 focus:outline-none focus:border-interactive focus:ring-2 focus:ring-interactive transition-colors"
      ></textarea>
    </div>

    <!-- Honeypot anti-spam: oculto visualmente, no con display:none (bots simples lo detectan). Un humano nunca lo completa. -->
    <div class="absolute -left-[9999px] w-px h-px overflow-hidden" aria-hidden="true">
      <label for="companyWebsite">No completar este campo</label>
      <input
        type="text"
        id="companyWebsite"
        name="companyWebsite"
        tabindex="-1"
        autocomplete="off"
      />
    </div>

    <div class="flex items-start gap-3">
      <input
        type="checkbox"
        id="policyAccepted"
        required
        class="mt-1 h-5 w-5 shrink-0 rounded-none border-secondary text-secondary focus:ring-interactive"
      />
      <label for="policyAccepted" class="text-sm text-neutral-900">
        He leído y acepto la{' '}
        <a
          href={POLICY_URL}
          target="_blank"
          rel="noopener"
          class="text-secondary underline decoration-interactive decoration-2 underline-offset-2"
        >
          Política de Tratamiento de Datos Personales
        </a>
        .
      </label>
    </div>
    <p id="policyError" class="text-sm text-red-800 font-bold hidden">
      Debes aceptar la Política de Tratamiento de Datos Personales para continuar.
    </p>

    <!-- Copia opcional del mensaje al propio visitante (la envía el servidor al
         correo que indicó arriba; el estado real del envío se informa al terminar). -->
    <div class="flex items-start gap-3">
      <input
        type="checkbox"
        id="sendCopy"
        class="mt-1 h-5 w-5 shrink-0 rounded-none border-secondary text-secondary focus:ring-interactive"
      />
      <label for="sendCopy" class="text-sm text-neutral-900">
        Enviarme una copia de este mensaje a mi correo.
      </label>
    </div>

    {
      turnstileSiteKey && (
        <div>
          <div
            class="cf-turnstile"
            data-sitekey={turnstileSiteKey}
            data-language="es"
            data-theme="light"
          />
          <p id="captchaError" class="text-sm text-red-800 font-bold mt-2 hidden">
            Completa la verificación para enviar el mensaje.
          </p>
        </div>
      )
    }

    <button
      type="submit"
      class="w-full md:w-auto px-8 py-4 border-2 border-accent bg-accent text-neutral-900 text-xs font-extrabold tracking-label uppercase transition-colors hover:border-neutral-900 hover:bg-neutral-900 hover:text-white focus-visible:outline focus-visible:outline-4 focus-visible:outline-offset-4 focus-visible:outline-interactive disabled:opacity-50 disabled:cursor-not-allowed"
    >
      Enviar mensaje
    </button>

    <p id="formError" role="alert" class="text-sm text-red-800 font-bold hidden"></p>
  </form>

  <!-- Pantalla de éxito: reemplaza al formulario. El texto dinámico (nombre y
       correo) lo inserta lead-form.js con textContent, nunca como HTML. -->
  <div
    id="formSuccess"
    role="status"
    aria-live="polite"
    tabindex="-1"
    class="hidden border-l-8 border-l-accent bg-neutral-50 p-6 md:p-8 focus:outline-none"
  >
    <p class="text-xs font-bold tracking-label uppercase text-secondary mb-3">Mensaje enviado</p>
    <h3
      id="successTitle"
      class="font-heading text-2xl md:text-3xl font-extrabold tracking-tight text-secondary mb-4"
    >
      ¡Gracias! Recibimos tu mensaje
    </h3>
    <p id="successText" class="text-neutral-900 leading-relaxed mb-6"></p>
    <p id="successCopy" class="text-neutral-900 font-bold mb-6 hidden"></p>

    <p class="text-xs font-bold tracking-label uppercase text-secondary mb-3">Qué sigue</p>
    <ol class="list-decimal pl-5 space-y-2 text-neutral-900 mb-8">
      <li>Revisamos lo que nos cuentas sobre tu operación.</li>
      <li>Te escribimos con una propuesta concreta.</li>
      <li>Definimos juntos los siguientes pasos.</li>
    </ol>

    <button
      type="button"
      id="sendAnother"
      class="inline-flex min-h-11 items-center justify-center border-2 border-neutral-900 px-5 text-xs font-extrabold uppercase tracking-label text-neutral-900 transition-colors hover:border-interactive hover:bg-white focus-visible:outline focus-visible:outline-4 focus-visible:outline-offset-4 focus-visible:outline-interactive"
    >
      Enviar otro mensaje
    </button>
  </div>
</div>

<!-- El script vive en /public/scripts/ (no inline aquí) porque la CSP del
     sitio bloquea scripts inline en producción — este formulario es el
     único flujo real de captura de leads del sitio, ver CONTEXT.md §5. -->
<script src="/scripts/lead-form.js" is:inline></script>
{
  turnstileSiteKey && (
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer is:inline />
  )
}
