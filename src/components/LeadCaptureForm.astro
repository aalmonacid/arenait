---
import { POLICY_URL, POLICY_VERSION } from '../lib/legal';

interface Props {
  showServiceDropdown?: boolean;
  services?: { title: string }[];
}

const {
  showServiceDropdown = false,
  services = [
    { title: 'Desarrollo de software a la medida' },
    { title: 'Implementación de aplicaciones' },
    { title: 'Gestión de proyectos de TI' },
    { title: 'Business Intelligence' },
    { title: 'Aseguramiento de la calidad (QA / Testing)' },
    { title: 'Mantenimiento y migración de software' },
  ],
}: Props = Astro.props;
---

<div class="bg-neutral-50 p-8 md:p-12 border-2 border-neutral-200 max-w-3xl mx-auto font-body">
  <h3 class="text-3xl font-heading mb-8 text-secondary tracking-tight">Cuéntanos tu reto</h3>

  <form id="leadCaptureForm" class="space-y-6" data-policy-version={POLICY_VERSION}>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div>
        <label
          for="fullName"
          class="block text-sm font-bold tracking-widest uppercase mb-2 text-neutral-900"
          >Nombre Completo</label
        >
        <input
          type="text"
          id="fullName"
          required
          class="w-full bg-white border border-neutral-200 px-4 py-3 text-neutral-900 focus:outline-none focus:border-interactive focus:ring-1 focus:ring-interactive transition-colors"
        />
      </div>
      <div>
        <label
          for="company"
          class="block text-sm font-bold tracking-widest uppercase mb-2 text-neutral-900"
          >Empresa</label
        >
        <input
          type="text"
          id="company"
          class="w-full bg-white border border-neutral-200 px-4 py-3 text-neutral-900 focus:outline-none focus:border-interactive focus:ring-1 focus:ring-interactive transition-colors"
        />
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div>
        <label
          for="corporateEmail"
          class="block text-sm font-bold tracking-widest uppercase mb-2 text-neutral-900"
          >Correo</label
        >
        <input
          type="email"
          id="corporateEmail"
          required
          placeholder="nombre@empresa.com"
          class="w-full bg-white border border-neutral-200 px-4 py-3 text-neutral-900 focus:outline-none focus:border-interactive focus:ring-1 focus:ring-interactive transition-colors"
        />
        <p id="emailError" class="text-sm text-red-600 font-bold mt-2 hidden">
          Por favor, ingrese un correo válido.
        </p>
      </div>
      <div>
        <label
          for="phone"
          class="block text-sm font-bold tracking-widest uppercase mb-2 text-neutral-900"
          >Teléfono (opcional)</label
        >
        <input
          type="tel"
          id="phone"
          class="w-full bg-white border border-neutral-200 px-4 py-3 text-neutral-900 focus:outline-none focus:border-interactive focus:ring-1 focus:ring-interactive transition-colors"
        />
      </div>
    </div>

    {
      showServiceDropdown && (
        <div>
          <label
            for="serviceOfInterest"
            class="block text-sm font-bold tracking-widest uppercase mb-2 text-neutral-900"
          >
            Servicio de interés
          </label>
          <select
            id="serviceOfInterest"
            class="w-full bg-white border border-neutral-200 px-4 py-3 text-neutral-900 focus:outline-none focus:border-interactive focus:ring-1 focus:ring-interactive transition-colors"
          >
            <option value="" selected>
              Seleccione un servicio...
            </option>
            {services.map((service) => (
              <option value={service.title}>{service.title}</option>
            ))}
          </select>
        </div>
      )
    }

    <div>
      <label
        for="message"
        class="block text-sm font-bold tracking-widest uppercase mb-2 text-neutral-900"
        >Cuéntanos tu reto</label
      >
      <textarea
        id="message"
        rows="4"
        required
        class="w-full bg-white border border-neutral-200 px-4 py-3 text-neutral-900 focus:outline-none focus:border-interactive focus:ring-1 focus:ring-interactive transition-colors"
      ></textarea>
    </div>

    <!-- Honeypot anti-spam: oculto visualmente, no con display:none (bots simples lo detectan). Un humano nunca lo completa. -->
    <div class="absolute -left-[9999px] w-px h-px overflow-hidden" aria-hidden="true">
      <label for="companyWebsite">No completar este campo</label>
      <input
        type="text"
        id="companyWebsite"
        name="companyWebsite"
        tabindex="-1"
        autocomplete="off"
      />
    </div>

    <div class="flex items-start gap-3">
      <input
        type="checkbox"
        id="policyAccepted"
        required
        class="mt-1 h-4 w-4 shrink-0 border-neutral-200 text-primary focus:ring-interactive"
      />
      <label for="policyAccepted" class="text-sm text-neutral-900">
        He leído y acepto la{' '}
        <a href={POLICY_URL} target="_blank" rel="noopener" class="text-interactive underline">
          Política de Tratamiento de Datos Personales
        </a>
        .
      </label>
    </div>
    <p id="policyError" class="text-sm text-red-600 font-bold hidden">
      Debes aceptar la Política de Tratamiento de Datos Personales para continuar.
    </p>

    <button
      type="submit"
      class="w-full md:w-auto px-8 py-4 bg-primary hover:bg-interactive text-white font-bold tracking-widest uppercase transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
    >
      Enviar mensaje
    </button>

    <p id="formSuccess" class="text-sm text-green-700 font-bold hidden">
      Mensaje enviado correctamente. Te respondemos con una propuesta concreta.
    </p>
    <p id="formError" class="text-sm text-red-600 font-bold hidden"></p>
  </form>
</div>

<script>
  const form = document.getElementById('leadCaptureForm') as HTMLFormElement;
  const emailInput = document.getElementById('corporateEmail') as HTMLInputElement;
  const companyInput = document.getElementById('company') as HTMLInputElement;
  const phoneInput = document.getElementById('phone') as HTMLInputElement;
  const serviceOfInterestInput = document.getElementById(
    'serviceOfInterest',
  ) as HTMLSelectElement | null;
  const messageInput = document.getElementById('message') as HTMLTextAreaElement;
  const fullNameInput = document.getElementById('fullName') as HTMLInputElement;
  const honeypotInput = document.getElementById('companyWebsite') as HTMLInputElement;
  const policyAcceptedInput = document.getElementById('policyAccepted') as HTMLInputElement;
  const policyError = document.getElementById('policyError');
  const emailError = document.getElementById('emailError');
  const submitButton = form?.querySelector('button[type="submit"]') as HTMLButtonElement | null;
  const formSuccess = document.getElementById('formSuccess');
  const formError = document.getElementById('formError');

  if (serviceOfInterestInput) {
    const preselected = new URLSearchParams(window.location.search).get('servicio');
    if (preselected) {
      const match = Array.from(serviceOfInterestInput.options).find(
        (option) => option.value === preselected,
      );
      if (match) {
        serviceOfInterestInput.value = preselected;
      }
    }
  }

  if (form && emailInput && emailError && submitButton && formSuccess && formError) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      formSuccess.classList.add('hidden');
      formError.classList.add('hidden');
      policyError?.classList.add('hidden');

      if (!policyAcceptedInput?.checked) {
        policyError?.classList.remove('hidden');
        return;
      }

      if (honeypotInput?.value) {
        // Probablemente un bot: simular éxito sin llamar a la API para no darle señal de qué falló.
        formSuccess.classList.remove('hidden');
        form.reset();
        return;
      }

      submitButton.disabled = true;
      submitButton.textContent = 'Enviando...';

      try {
        const response = await fetch('/api/leads', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            fullName: fullNameInput?.value ?? '',
            company: companyInput?.value ?? '',
            corporateEmail: emailInput.value,
            phone: phoneInput?.value ?? '',
            serviceOfInterest: serviceOfInterestInput?.value ?? '',
            message: messageInput?.value ?? '',
            source: 'lead-capture-form',
            companyWebsite: honeypotInput?.value ?? '',
            policyAccepted: policyAcceptedInput?.checked ?? false,
            policyVersion: form.dataset.policyVersion ?? '',
          }),
        });

        const data = await response.json();

        if (!response.ok || !data.ok) {
          throw new Error(data.error || 'No se pudo enviar el mensaje.');
        }

        formSuccess.classList.remove('hidden');
        form.reset();
      } catch (err) {
        formError.textContent =
          err instanceof Error ? err.message : 'No se pudo enviar el mensaje. Intente nuevamente.';
        formError.classList.remove('hidden');
      } finally {
        submitButton.disabled = false;
        submitButton.textContent = 'Enviar mensaje';
      }
    });

    emailInput.addEventListener('input', () => {
      emailError.classList.add('hidden');
    });
  }
</script>
