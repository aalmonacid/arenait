---
import type { ServiceSchema } from '../types/sanity';

interface Props {
  service: ServiceSchema;
}

const { service } = Astro.props;
---
<article class="border-2 border-neutral-200 bg-white p-8 hover:border-primary transition-colors duration-300">
  <div class="flex items-start justify-between mb-6">
    <h3 class="text-2xl font-heading text-secondary mb-2 leading-tight">{service.title}</h3>
    {service.iso27001Compliant && (
      <span class="inline-flex items-center px-2 py-1 text-xs font-bold uppercase tracking-widest text-interactive bg-blue-50 border border-interactive whitespace-nowrap ml-4">
        ISO 27001
      </span>
    )}
  </div>
  
  <p class="text-neutral-900 leading-relaxed mb-8">{service.description}</p>
  
  <div class="grid grid-cols-2 gap-4 border-t border-neutral-200 pt-6">
    <div class="flex flex-col">
      <span class="text-xs font-bold uppercase tracking-wider text-neutral-500 mb-1">TCO Savings</span>
      <span class="text-2xl font-heading text-accent">-{service.tcoSavingsPercentage}%</span>
    </div>
    <div class="flex flex-col">
      <span class="text-xs font-bold uppercase tracking-wider text-neutral-500 mb-1">Guaranteed SLA</span>
      <span class="text-2xl font-heading text-primary">{service.sla}</span>
    </div>
  </div>
  
  {service.metrics && service.metrics.length > 0 && (
    <div class="mt-8 space-y-3">
      {service.metrics.map(metric => (
        <div class="flex justify-between items-center text-sm border-b border-neutral-200 pb-2 last:border-0 last:pb-0">
          <span class="text-neutral-900">{metric.label}</span>
          <span class="font-bold text-secondary">{metric.value}</span>
        </div>
      ))}
    </div>
  )}
</article>
