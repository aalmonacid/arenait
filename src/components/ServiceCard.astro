---
import Icon from './Icon.astro';
import type { ServiceSchema } from '../types/sanity';

interface Props {
  service: ServiceSchema;
}

const { service } = Astro.props;
---

<article
  class="border-2 border-neutral-200 bg-white p-8 hover:border-primary transition-colors duration-300"
>
  {
    service.icon && (
      <div class="text-primary mb-4">
        <Icon name={service.icon as any} />
      </div>
    )
  }
  <h3 class="text-2xl font-heading text-secondary mb-3 leading-tight">{service.title}</h3>
  <p class="text-neutral-900 leading-relaxed">{service.summary}</p>
</article>
