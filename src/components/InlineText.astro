---
/**
 * Texto editable con enlaces internos escritos como [texto](/ruta) o
 * [texto](#ancla) (ver src/lib/inlineLinks.ts). Todo lo demás se escapa como texto.
 */
import { parseInlineLinks } from '../lib/inlineLinks';

interface Props {
  text: string;
  /** Clases del enlace; por defecto subrayado con color interactive (no es color de texto). */
  linkClass?: string;
}

const {
  text,
  linkClass = 'font-bold text-secondary underline decoration-interactive decoration-2 underline-offset-4',
}: Props = Astro.props;
const segments = parseInlineLinks(text);
---
{segments.map((s) => (s.href ? <a href={s.href} class={linkClass}>{s.text}</a> : s.text))}
