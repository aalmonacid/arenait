---
interface Props {
  label: string;
}

const { label } = Astro.props;
---

<span
  class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-wide text-neutral-500 border border-dashed border-neutral-400 px-3 py-1.5 bg-neutral-50"
>
  <svg
    class="w-3.5 h-3.5 shrink-0"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
  >
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
  </svg>
  {label} — pendiente de confirmar con el cliente
</span>
