---
/**
 * Sectores de experiencia. Compartido por el inicio, /servicios (en otro
 * formato) y /nosotros: los sectores vienen de los ajustes del sitio (Sanity,
 * con respaldo en el código) y cada uno enlaza al filtro de /proyectos.
 */
import type { SectorSchema } from '../types/sanity';

interface Props {
  sectors: SectorSchema[];
}

const { sectors }: Props = Astro.props;
---

<ul
  class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4 list-none p-0 m-0"
  aria-label="Sectores de experiencia"
>
  {
    sectors.map((sector) => (
      <li>
        <a
          href={`/proyectos?sector=${sector.key}`}
          class="block h-full min-h-11 border-2 border-neutral-200 bg-white p-6 pb-10 transition-colors duration-200 hover:border-interactive before:block before:h-1 before:w-8 before:bg-accent before:mb-6 focus-visible:outline focus-visible:outline-4 focus-visible:outline-offset-4 focus-visible:outline-interactive"
        >
          <span class="font-heading text-xl md:text-2xl font-extrabold tracking-tight text-secondary">
            {sector.gridLabel ?? sector.label}
          </span>
        </a>
      </li>
    ))
  }
</ul>
