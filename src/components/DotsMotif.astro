---
/**
 * Motivo gráfico de marca: la fila de 7 puntos del logo (2 pequeños, azul
 * medio, naranja grande al centro, azul medio, 2 pequeños — colores del
 * tablero de marca). Decorativo, entra con una animación CSS escalonada que
 * respeta prefers-reduced-motion y termina siempre en el estado visible.
 */
interface Props {
  class?: string;
  /** 'light' sobre fondos claros (azul), 'dark' sobre fondos oscuros (blanco). */
  variant?: 'light' | 'dark';
}

const { class: className = '', variant = 'light' } = Astro.props;
const small = variant === 'dark' ? '#FFFFFF' : '#0075C9';
---

<svg
  class={className}
  width="136"
  height="32"
  viewBox="0 0 136 32"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  <circle class="dot motion-safe:animate-pop" cx="4" cy="16" r="3" fill={small}></circle>
  <circle class="dot motion-safe:animate-pop-2" cx="22" cy="16" r="4" fill={small}></circle>
  <circle class="dot motion-safe:animate-pop-3" cx="44" cy="16" r="7" fill={small}></circle>
  <circle class="dot motion-safe:animate-pop-4" cx="72" cy="16" r="13" fill="#FEA621"></circle>
  <circle class="dot motion-safe:animate-pop-3" cx="100" cy="16" r="7" fill={small}></circle>
  <circle class="dot motion-safe:animate-pop-2" cx="122" cy="16" r="4" fill={small}></circle>
  <circle class="dot motion-safe:animate-pop" cx="132" cy="16" r="3" fill={small}></circle>
</svg>
