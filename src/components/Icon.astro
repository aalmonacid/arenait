  chart:
    'M9 19V6m0 13H5a1 1 0 01-1-1v-2a1 1 0 011-1h4m0 4h6m5 0h-4a1 1 0 01-1-1V9a1 1 0 011-1h4a1 1 0 011 1v9a1 1 0 01-1 1zM9 19V4a1 1 0 011-1h0a1 1 0 011 1v15',
