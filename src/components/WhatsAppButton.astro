---
/**
 * Botón flotante de WhatsApp. Los datos de contacto viven en src/lib/contact.ts.
 *
 * Diseño dentro del sistema de marca (auditoría 14/11/2026): rectángulo de
 * bordes rectos, fondo `secondary` con texto blanco (≈8,7:1) y etiqueta visible
 * desde `sm`. El verde de WhatsApp (#25D366) con glifo blanco daba ≈2:1, bajo el
 * mínimo de 3:1 para elementos no textuales, y salía de la paleta.
 */
import { WHATSAPP_URL } from '../lib/contact';
---

<!-- role="region" (auditoría a11y 2026-09-04, Épica J): este link flotante vive
     fuera de header/main/footer, así que sin un landmark propio quedaba fuera de
     cualquier región para lectores de pantalla (regla axe-core "region"). El rol va
     en el contenedor, no en el <a>, para no pisar la semántica nativa de link. -->
<div role="region" aria-label="Contacto por WhatsApp" class="fixed bottom-4 right-4 sm:bottom-6 sm:right-6 z-50">
  <a
    id="whatsapp-float"
    href={WHATSAPP_URL}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Escribir por WhatsApp"
    class="flex min-h-14 items-center justify-center gap-3 rounded-none border-2 border-secondary bg-secondary px-4 text-white shadow-lg transition-colors hover:border-neutral-900 hover:bg-neutral-900 focus-visible:outline focus-visible:outline-4 focus-visible:outline-offset-4 focus-visible:outline-interactive"
  >
    <svg viewBox="0 0 24 24" fill="currentColor" class="w-6 h-6" aria-hidden="true">
      <path
        d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.28-1.38a9.9 9.9 0 004.76 1.21h.01c5.46 0 9.9-4.45 9.9-9.92C21.96 6.45 17.51 2 12.04 2zm5.8 14.02c-.24.68-1.4 1.3-1.93 1.38-.5.08-1.13.11-1.82-.11-.42-.13-.96-.31-1.65-.61-2.9-1.25-4.79-4.17-4.94-4.37-.15-.2-1.18-1.57-1.18-2.99 0-1.42.75-2.12 1.01-2.41.27-.29.58-.36.78-.36.19 0 .39 0 .56.01.18.01.42-.07.65.5.24.58.82 2 .89 2.14.07.15.12.32.02.52-.1.2-.15.32-.29.49-.15.17-.31.39-.44.52-.15.15-.3.31-.13.6.17.3.76 1.25 1.63 2.03 1.12 1 2.06 1.31 2.36 1.46.3.15.47.13.65-.08.18-.2.75-.87.95-1.17.2-.3.4-.25.65-.15.27.1 1.7.8 1.99.94.29.15.48.22.55.34.08.13.08.72-.16 1.4z"
      ></path>
    </svg>
    <span class="hidden sm:inline text-xs font-extrabold uppercase tracking-label">WhatsApp</span>
  </a>
</div>
