---
/**
 * Cabecera editorial de sección: regla gruesa arriba, etiqueta en
 * mayúsculas espaciadas a la izquierda (columnas 1-3) y titular a la derecha
 * (columnas 4-12) sobre una grilla de 12 columnas. Sin numeración
 * decorativa: los números solo se usan donde el orden es información real
 * (ver ProcessFlow).
 */
interface Props {
  label: string;
  title: string;
  id?: string;
  /** 'dark' para secciones con fondo secondary (regla y etiqueta en blanco). */
  variant?: 'light' | 'dark';
}

const { label, title, id, variant = 'light' } = Astro.props;
const dark = variant === 'dark';
---

<div
  class={`grid grid-cols-1 md:grid-cols-12 gap-x-6 gap-y-4 border-t-2 pt-5 mb-12 md:mb-16 ${dark ? 'border-white' : 'border-neutral-900'}`}
>
  <p
    class={`md:col-span-3 text-xs font-bold uppercase tracking-label md:pt-3 ${dark ? 'text-white' : 'text-secondary'}`}
  >
    {label}
  </p>
  <h2
    id={id}
    class={`md:col-span-9 font-heading text-headline max-w-headline text-balance ${dark ? 'text-white' : 'text-neutral-900'}`}
  >
    {title}
  </h2>
</div>
