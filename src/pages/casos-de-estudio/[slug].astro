---
export const prerender = true;

import BaseLayout from '../../layouts/BaseLayout.astro';
import { client } from '../../lib/sanity';
import { fallbackCaseStudies } from '../../lib/fallbackContent';
import { urlForImage } from '../../lib/imageBuilder';
import type { CaseStudySchema } from '../../types/sanity';

export async function getStaticPaths() {
  try {
    const caseStudies = await client.fetch<{ slug: { current: string } }[]>(
      `*[_type == "caseStudy"] { slug }`,
    );

    if (caseStudies && caseStudies.length > 0) {
      return caseStudies.map((caseStudy: any) => ({
        params: { slug: caseStudy.slug.current },
      }));
    }
  } catch (error) {
    console.error('Error fetching case study slugs from Sanity:', error);
  }

  // Sin contenido real en Sanity todavía, se usa el único caso verificado
  // (Sadep) como fallback — no es una invención, es un cliente real (ver
  // copy-arenait-textos-reales.md). Otros casos siguen sin fallback: un caso
  // de estudio implica un cliente y resultados reales, no algo que sea
  // correcto simular.
  return fallbackCaseStudies.map((caseStudy) => ({
    params: { slug: caseStudy.slug.current },
  }));
}

const { slug } = Astro.params;

let caseStudy: CaseStudySchema | null = null;

try {
  const query = `*[_type == "caseStudy" && slug.current == $slug][0]`;
  caseStudy = await client.fetch<CaseStudySchema>(query, { slug });
} catch (error) {
  console.error('Error fetching case study from Sanity:', error);
}

if (!caseStudy) {
  caseStudy = fallbackCaseStudies.find((item) => item.slug.current === slug) ?? null;
}

if (!caseStudy) {
  return Astro.redirect('/404');
}

// JSON-LD: BreadcrumbList Home › Casos de Estudio › [caso], con URLs reales.
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Home',
        item: new URL('/', Astro.site).toString(),
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Casos de Estudio',
        item: new URL('/casos-de-estudio', Astro.site).toString(),
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: caseStudy.title,
        item: new URL(`/casos-de-estudio/${slug}`, Astro.site).toString(),
      },
    ],
  },
];

// Meta description específica del caso (en vez del genérico "Caso de
// estudio: <cliente>"): usa solo hechos ya presentes en fallbackCaseStudies
// (cliente + título + solución real construida), sin agregar cifras ni
// afirmaciones nuevas. Se recorta a ~160 caracteres en un límite de palabra.
function truncateDescription(text: string, max = 160): string {
  if (text.length <= max) return text;
  const cut = text.slice(0, max);
  const lastSpace = cut.lastIndexOf(' ');
  return `${cut.slice(0, lastSpace)}…`;
}

const metaDescription = truncateDescription(
  `Caso ${caseStudy.client}: ${caseStudy.title}. ${caseStudy.solution}`,
);
---

<BaseLayout title={caseStudy.title} description={metaDescription} structuredData={structuredData}>
  <article class="bg-white min-h-screen">
    <header class="bg-secondary text-white py-24 md:py-32 px-4 md:px-8 border-b-8 border-accent">
      <div class="max-w-7xl mx-auto">
        <p class="text-sm font-bold uppercase tracking-widest text-accent mb-4">
          {caseStudy.industry} · {caseStudy.client}
        </p>
        <h1 class="text-4xl md:text-6xl font-heading mb-6 tracking-tight text-white">
          {caseStudy.title}
        </h1>
      </div>
    </header>

    <section class="py-24 px-4 md:px-8 border-b border-neutral-200">
      <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-3 gap-16">
        <div class="lg:col-span-2 space-y-12">
          <div>
            <h2 class="text-3xl font-heading text-secondary mb-6">El reto</h2>
            <p class="text-lg text-neutral-900 leading-relaxed whitespace-pre-line">
              {caseStudy.challenge}
            </p>
          </div>
          <div>
            <h2 class="text-3xl font-heading text-secondary mb-6">Lo que construimos</h2>
            <p class="text-lg text-neutral-900 leading-relaxed whitespace-pre-line">
              {caseStudy.solution}
            </p>
          </div>
        </div>

        <div class="space-y-8">
          <div class="bg-secondary p-8 text-white">
            <h3 class="text-lg font-bold tracking-widest uppercase mb-6 text-neutral-300">
              Resultado
            </h3>
            <ul class="space-y-4">
              {
                caseStudy.results?.map((result) => (
                  <li class="flex items-start gap-3">
                    <span class="text-accent font-bold">→</span>
                    <span>{result}</span>
                  </li>
                ))
              }
            </ul>
          </div>

          <a
            href="/contacto"
            class="block w-full text-center bg-primary hover:bg-interactive text-white font-bold tracking-widest uppercase py-4 transition-colors"
          >
            Cuéntanos tu reto
          </a>
        </div>
      </div>
    </section>

    <section class="py-24 px-4 md:px-8 bg-neutral-50">
      <div class="max-w-7xl mx-auto">
        <h2 class="text-3xl font-heading text-secondary mb-10">Cómo se ve en producción</h2>
        {
          caseStudy.screenshots && caseStudy.screenshots.length > 0 ? (
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
              {caseStudy.screenshots.map((screenshot) => (
                <img
                  src={urlForImage(screenshot).width(1200).url()}
                  alt={`Captura de pantalla real de la plataforma construida para ${caseStudy?.client}`}
                  loading="lazy"
                  decoding="async"
                  class="w-full h-auto border-2 border-neutral-200"
                />
              ))}
            </div>
          ) : (
            <div class="border-2 border-dashed border-neutral-300 bg-white p-10 md:p-16 text-center">
              <p class="text-sm font-bold uppercase tracking-widest text-neutral-500 mb-2">
                Capturas reales pendientes
              </p>
              <p class="text-neutral-900 max-w-xl mx-auto">
                Todavía no se han recibido capturas reales de {caseStudy.client} para mostrar aquí.
                Esta sección se completa únicamente con imágenes reales del producto — nunca con
                mockups o renders genéricos.
              </p>
            </div>
          )
        }
      </div>
    </section>
  </article>
</BaseLayout>
