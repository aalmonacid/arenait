---
export const prerender = true;

import BaseLayout from '../../layouts/BaseLayout.astro';
import { client } from '../../lib/sanity';
import { fallbackCaseStudies } from '../../lib/fallbackContent';
import type { CaseStudySchema } from '../../types/sanity';

let caseStudies: CaseStudySchema[] = [];

try {
  caseStudies = await client.fetch<CaseStudySchema[]>(`*[_type == "caseStudy"]`);
} catch (error) {
  console.error('Error fetching case studies from Sanity:', error);
}

if (!caseStudies || caseStudies.length === 0) {
  caseStudies = fallbackCaseStudies;
}
---

<BaseLayout
  title="Casos de Estudio"
  description="Estos son proyectos reales que hemos construido. Estamos documentando más casos a medida que cerramos nuevos proyectos."
>
  <header class="bg-secondary text-white py-24 md:py-32 px-4 md:px-8 border-b-8 border-accent">
    <div class="max-w-7xl mx-auto">
      <h1 class="text-4xl md:text-6xl font-heading mb-6 tracking-tight text-white">
        Casos de Estudio
      </h1>
      <p class="text-xl md:text-2xl text-neutral-300 max-w-3xl leading-relaxed">
        Estos son proyectos reales que hemos construido. Estamos documentando más casos a medida que
        cerramos nuevos proyectos.
      </p>
    </div>
  </header>

  <section class="py-24 px-4 md:px-8 bg-neutral-50">
    <div class="max-w-7xl mx-auto">
      {
        caseStudies.length === 0 ? (
          <div class="text-center py-24 border-2 border-dashed border-neutral-200">
            <p class="text-lg text-neutral-600 max-w-xl mx-auto">
              ¿Quieres ser el próximo caso de éxito? Cuéntanos tu proyecto —{' '}
              <a href="/contacto" class="text-interactive font-bold underline">
                contáctanos
              </a>
              .
            </p>
          </div>
        ) : (
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {caseStudies.map((caseStudy) => (
              <a
                href={`/casos-de-estudio/${caseStudy.slug.current}`}
                class="block border-2 border-neutral-200 bg-white p-8 hover:border-primary transition-colors duration-300"
              >
                <p class="text-xs font-bold uppercase tracking-widest text-interactive mb-2">
                  {caseStudy.industry}
                </p>
                <h2 class="text-2xl font-heading text-secondary mb-4 leading-tight">
                  {caseStudy.title}
                </h2>
                <p class="text-sm font-bold uppercase tracking-widest text-neutral-500">
                  {caseStudy.client}
                </p>
              </a>
            ))}
          </div>
        )
      }
    </div>
  </section>
</BaseLayout>
