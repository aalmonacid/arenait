---
export const prerender = true;

import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { client } from '../../lib/sanity';
import { fallbackCaseStudies } from '../../lib/fallbackContent';
import type { CaseStudySchema } from '../../types/sanity';

let caseStudies: CaseStudySchema[] = [];

try {
  caseStudies = await client.fetch<CaseStudySchema[]>(`*[_type == "caseStudy"]`);
} catch (error) {
  console.error('Error fetching case studies from Sanity:', error);
}

if (!caseStudies || caseStudies.length === 0) {
  caseStudies = fallbackCaseStudies;
}
---

<BaseLayout
  title="Casos de Estudio"
  description="Estos son proyectos reales que hemos construido. Estamos documentando más casos a medida que cerramos nuevos proyectos."
>
  <PageHero
    kicker="Casos de estudio"
    title="Casos de Estudio"
    lead="Estos son proyectos reales que hemos construido. Estamos documentando más casos a medida que cerramos nuevos proyectos."
  />

  <section class="py-16 md:py-24 px-4 md:px-8 bg-neutral-50">
    <div class="max-w-7xl mx-auto">
      {
        caseStudies.length === 0 ? (
          <div class="py-20 text-center border-2 border-dashed border-neutral-200">
            <p class="text-lg text-neutral-900 max-w-xl mx-auto">
              ¿Quieres ser el próximo caso de éxito? Cuéntanos tu proyecto —{' '}
              <a
                href="/contacto"
                class="font-bold text-secondary underline decoration-interactive decoration-2 underline-offset-4"
              >
                contáctanos
              </a>
              .
            </p>
          </div>
        ) : (
          <ul class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-px bg-neutral-200 border border-neutral-200 list-none p-0 m-0">
            {caseStudies.map((caseStudy) => (
              <li class="bg-white">
                <a
                  href={`/casos-de-estudio/${caseStudy.slug.current}`}
                  class="group flex h-full min-h-72 flex-col border-2 border-transparent p-8 transition-colors duration-200 hover:border-primary focus-visible:outline focus-visible:outline-4 focus-visible:outline-offset-4 focus-visible:outline-interactive"
                >
                  <p class="text-xs font-bold uppercase tracking-label text-secondary mb-4">
                    {caseStudy.industry}
                  </p>
                  <h2 class="font-heading text-2xl font-extrabold tracking-tight leading-tight text-secondary text-balance mb-4">
                    {caseStudy.title}
                  </h2>
                  <p class="text-xs font-bold uppercase tracking-label text-neutral-900">
                    {caseStudy.client}
                  </p>
                  <span class="mt-auto pt-8 inline-flex items-center gap-3 text-xs font-extrabold uppercase tracking-label text-neutral-900 after:block after:h-0.5 after:w-6 after:bg-current after:transition-all after:duration-200 group-hover:after:w-14">
                    Ver caso
                  </span>
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </section>
</BaseLayout>
