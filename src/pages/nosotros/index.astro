---
export const prerender = true;

import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import SectionHead from '../../components/SectionHead.astro';
import SectorGrid from '../../components/SectorGrid.astro';
import ClosingCta from '../../components/ClosingCta.astro';
import { getAboutPage, getSiteSettings } from '../../lib/content';

const [page, settings] = await Promise.all([getAboutPage(), getSiteSettings()]);

// Imágenes derivadas con `node scripts/make-images.mjs` a partir de la misma
// foto real (scripts/img-src/nosotros-facade.jpg). El adaptador de Cloudflare
// usa `passthrough` (no optimiza en ejecución), así que se sirven ya
// redimensionadas: og-nosotros.jpg 1200x630 para compartir, y tres anchos
// WebP cuadrados para la foto de la página.
const ogImage = '/og-nosotros.jpg';
---

<BaseLayout
  title={page.seoTitle}
  description={page.seoDescription}
  ogImage={ogImage}
>
  <PageHero kicker={page.heroEyebrow} title={page.heroTitle} lead={page.heroIntro} />

  <section class="py-16 md:py-28 px-4 md:px-8 bg-white" aria-labelledby="quienes-title">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-x-6 gap-y-12 items-start">
      <div class="lg:col-span-7">
        <h2
          id="quienes-title"
          class="font-heading text-2xl md:text-3xl font-extrabold tracking-tight leading-snug text-secondary text-balance"
        >
          {page.whoTitle}
        </h2>
        <div class="mt-8 flex flex-col gap-5 text-lg text-neutral-900 leading-relaxed">
          {page.whoParagraphs.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </div>
      <div class="lg:col-span-5">
        <img
          src="/images/nosotros-800.webp"
          srcset="/images/nosotros-480.webp 480w, /images/nosotros-800.webp 800w, /images/nosotros-1200.webp 1200w"
          sizes="(min-width: 1024px) 40vw, 100vw"
          width="1200"
          height="1200"
          alt=""
          loading="lazy"
          decoding="async"
          class="w-full aspect-square object-cover border border-neutral-200"
        />
      </div>
    </div>
  </section>

  <section class="py-16 md:py-28 px-4 md:px-8 bg-neutral-50" aria-labelledby="mision-title">
    <div class="max-w-7xl mx-auto">
      <SectionHead id="mision-title" label="Misión y visión" title={page.missionVisionTitle} />
      <div class="grid grid-cols-1 md:grid-cols-2 gap-px bg-neutral-200 border border-neutral-200">
        <div class="bg-white p-8 md:p-12">
          <h3 class="text-xs font-bold uppercase tracking-label text-secondary mb-4">Misión</h3>
          <p class="text-lg text-neutral-900 leading-relaxed">{page.mission}</p>
        </div>
        <div class="bg-white p-8 md:p-12">
          <h3 class="text-xs font-bold uppercase tracking-label text-secondary mb-4">Visión</h3>
          <p class="text-lg text-neutral-900 leading-relaxed">{page.vision}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 md:py-28 px-4 md:px-8 bg-white" aria-labelledby="principios-title">
    <div class="max-w-7xl mx-auto">
      <SectionHead id="principios-title" label="Lo que nos guía" title={page.principlesTitle} />
      <ul
        class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 list-none p-0 m-0"
        aria-label="Principios"
      >
        {
          page.principles.map((principle) => (
            <li class="border-2 border-neutral-200 border-t-4 border-t-accent bg-white p-6">
              <h3 class="font-heading text-xl font-extrabold text-secondary mb-3">
                {principle.title}
              </h3>
              <p class="leading-relaxed text-neutral-900">{principle.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="py-16 md:py-28 px-4 md:px-8 bg-neutral-50" aria-labelledby="sectores-title">
    <div class="max-w-7xl mx-auto">
      <SectionHead id="sectores-title" label="Sectores" title={page.sectorsTitle} />
      <SectorGrid sectors={settings.sectors} />
    </div>
  </section>

  <ClosingCta
    title={page.closingTitle}
    byline={`${settings.managerName} · ${settings.managerRole}`}
    links={page.closingLinks}
  />
</BaseLayout>
