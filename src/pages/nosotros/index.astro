---
export const prerender = true;

import { Image, getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import nosotrosImage from '../../assets/images/nosotros-facade.jpg';

// ogImage (Épica K de BACKLOG.md): BaseLayout espera una URL/ruta plana, no
// el componente <Image> optimizado de astro:assets. getImage() genera una
// copia estática 1200x630 (medida estándar de OG) recortada con `fit:
// 'cover'` de la misma foto real ya usada en el header de esta página — no
// se fabrica una imagen nueva, se deriva de la existente. `.src` es la ruta
// pública real que Astro emite en /_astro/ durante el build.
const ogImage = await getImage({
  src: nosotrosImage,
  width: 1200,
  height: 630,
  fit: 'cover',
  format: 'jpg',
  quality: 70,
});
---

<BaseLayout
  title="Quiénes somos"
  description="Arena IT es una empresa colombiana de desarrollo de software, dedicada a diseñar, construir e integrar soluciones tecnológicas a la medida de las necesidades reales de cada negocio."
  ogImage={ogImage.src}
>
  <header class="relative overflow-hidden bg-secondary text-white py-24 md:py-32 px-4 md:px-8 border-b-8 border-accent">
    <Image
      src={nosotrosImage}
      alt=""
      class="absolute inset-0 w-full h-full object-cover opacity-60"
      widths={[640, 1080, 1600, 2000]}
      sizes="100vw"
      loading="eager"
      quality={70}
    />
    <div class="absolute inset-0 hero-scrim"></div>
    <div class="max-w-7xl mx-auto relative">
      <h1 class="text-4xl md:text-6xl font-heading mb-6 tracking-tight text-white">
        Quiénes somos
      </h1>
    </div>
  </header>

  <section class="py-24 px-4 md:px-8 bg-white">
    <div class="max-w-3xl mx-auto space-y-12">
      <p class="text-lg text-neutral-900 leading-relaxed">
        Arena IT es una empresa colombiana de desarrollo de software, dedicada a diseñar, construir
        e integrar soluciones tecnológicas a la medida de las necesidades reales de cada negocio.
        Acompañamos a nuestros clientes desde el diseño de la solución hasta su mantenimiento en
        producción, con un enfoque en que el software funcione para la operación diaria — no solo en
        la demo.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 border-t border-neutral-200 pt-12">
        <div>
          <p class="text-sm font-bold tracking-widest uppercase text-neutral-500 mb-2">Misión</p>
          <p class="text-lg text-neutral-900 leading-relaxed">
            Brindar productos y servicios con alto grado de calidad en el campo de las
            tecnologías de información.
          </p>
        </div>
        <div>
          <p class="text-sm font-bold tracking-widest uppercase text-neutral-500 mb-2">Visión</p>
          <p class="text-lg text-neutral-900 leading-relaxed">
            Posicionarnos en el mercado como empresa líder en la provisión de servicios de
            tecnologías de información, consultorías y en el desarrollo de aplicaciones.
          </p>
        </div>
      </div>

      <div class="border-t border-neutral-200 pt-8">
        <p class="text-sm font-bold tracking-widest uppercase text-neutral-500 mb-2">
          Sectores con experiencia comprobada
        </p>
        <p class="text-lg text-neutral-900 leading-relaxed">
          Financiero, asegurador, servicios y agropecuario.
        </p>
      </div>

      <div class="border-t border-neutral-200 pt-8">
        <p class="text-sm font-bold tracking-widest uppercase text-neutral-500 mb-2">Contacto</p>
        <p class="text-lg font-heading text-secondary">Andrés Arena — Gerente</p>
      </div>
    </div>
  </section>
</BaseLayout>
