---
export const prerender = true;

import { Image, getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import SectionHead from '../../components/SectionHead.astro';
import SectorGrid from '../../components/SectorGrid.astro';
import Button from '../../components/Button.astro';
import nosotrosImage from '../../assets/images/nosotros-facade.jpg';

// ogImage (Épica K de BACKLOG.md): BaseLayout espera una URL/ruta plana, no
// el componente <Image> optimizado de astro:assets. getImage() genera una
// copia estática 1200x630 (medida estándar de OG) recortada con `fit:
// 'cover'` de la misma foto real usada en esta página — no se fabrica una
// imagen nueva, se deriva de la existente. `.src` es la ruta pública real
// que Astro emite en /_astro/ durante el build.
const ogImage = await getImage({
  src: nosotrosImage,
  width: 1200,
  height: 630,
  fit: 'cover',
  format: 'jpg',
  quality: 70,
});
---

<BaseLayout
  title="Quiénes somos"
  description="Arena IT es una empresa colombiana de desarrollo de software, dedicada a diseñar, construir e integrar soluciones tecnológicas a la medida de las necesidades reales de cada negocio."
  ogImage={ogImage.src}
>
  <PageHero kicker="Nosotros" title="Quiénes somos" />

  <section class="py-16 md:py-28 px-4 md:px-8 bg-white">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-x-6 gap-y-12 items-start">
      <p
        class="lg:col-span-7 font-heading text-2xl md:text-3xl font-extrabold tracking-tight leading-snug text-secondary"
      >
        Arena IT es una empresa colombiana de desarrollo de software, dedicada a diseñar, construir
        e integrar soluciones tecnológicas a la medida de las necesidades reales de cada negocio.
      </p>
      <div class="lg:col-span-5 lg:row-span-2">
        <Image
          src={nosotrosImage}
          alt=""
          class="w-full aspect-square object-cover border border-neutral-200"
          widths={[480, 800, 1200]}
          sizes="(min-width: 1024px) 40vw, 100vw"
          quality={70}
        />
      </div>
      <p class="lg:col-span-7 text-lg text-neutral-900 leading-relaxed">
        Acompañamos a nuestros clientes desde el diseño de la solución hasta su mantenimiento en
        producción, con un enfoque en que el software funcione para la operación diaria — no solo en
        la demo.
      </p>
    </div>
  </section>

  <section class="py-16 md:py-28 px-4 md:px-8 bg-neutral-50" aria-labelledby="mision-title">
    <div class="max-w-7xl mx-auto">
      <SectionHead id="mision-title" label="Misión y visión" title="Hacia dónde trabajamos." />
      <div class="grid grid-cols-1 md:grid-cols-2 gap-px bg-neutral-200 border border-neutral-200">
        <div class="bg-white p-8 md:p-12">
          <p class="text-xs font-bold uppercase tracking-label text-secondary mb-4">Misión</p>
          <p class="text-lg text-neutral-900 leading-relaxed">
            Brindar productos y servicios con alto grado de calidad en el campo de las tecnologías
            de información.
          </p>
        </div>
        <div class="bg-white p-8 md:p-12">
          <p class="text-xs font-bold uppercase tracking-label text-secondary mb-4">Visión</p>
          <p class="text-lg text-neutral-900 leading-relaxed">
            Posicionarnos en el mercado como empresa líder en la provisión de servicios de
            tecnologías de información, consultorías y en el desarrollo de aplicaciones.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 md:py-28 px-4 md:px-8 bg-white" aria-labelledby="sectores-title">
    <div class="max-w-7xl mx-auto">
      <SectionHead
        id="sectores-title"
        label="Experiencia"
        title="Sectores con experiencia comprobada."
      />
      <SectorGrid />
    </div>
  </section>

  <section class="py-16 md:py-24 px-4 md:px-8 bg-neutral-50 border-t border-neutral-200">
    <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-12 gap-x-6 gap-y-6 items-center">
      <div class="md:col-span-8">
        <p class="text-xs font-bold uppercase tracking-label text-secondary mb-3">Contacto</p>
        <p class="font-heading text-2xl md:text-3xl font-extrabold tracking-tight text-secondary">
          Andrés Arenas — Gerente
        </p>
      </div>
      <div class="md:col-span-4 md:text-right">
        <Button href="/contacto">Cuéntanos tu reto</Button>
      </div>
    </div>
  </section>
</BaseLayout>
