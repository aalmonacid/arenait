---
export const prerender = true;

import PolicyView from '../../components/PolicyView.astro';
import { getPolicies } from '../../lib/content';

// Política vigente: la de `effectiveDate` más reciente que no sea futura. Se
// edita en Sanity («Política de datos»); ver CONTEXT.md.
