---
export const prerender = true;

import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Button from '../../components/Button.astro';
import { client } from '../../lib/sanity';
import PendingContentTag from '../../components/PendingContentTag.astro';
import WhitepaperGateModal from '../../components/WhitepaperGateModal.astro';
import type { WhitepaperSchema } from '../../types/sanity';

// Proyección explícita: nunca se incluye `pdfFile` aquí. El _ref de un asset
// `file` de Sanity permite reconstruir su URL de descarga sin dereferenciarlo,
// así que traerlo a esta página prerenderizada ya sería filtrar el PDF antes
// de que alguien complete el formulario de /api/whitepaper-download.ts.
let whitepapers: WhitepaperSchema[] = [];

try {
  whitepapers = await client.fetch<WhitepaperSchema[]>(
    `*[_type == "whitepaper"] | order(title asc){_id, title, slug, summary, targetRole}`,
  );
} catch (error) {
  console.error('Error fetching whitepapers from Sanity:', error);
}

if (!whitepapers) {
  whitepapers = [];
}
---

<BaseLayout
  title="Recursos"
  description="Guías prácticas sobre desarrollo de software, migración de sistemas y datos, escritas con lo que hemos aprendido construyendo proyectos reales."
>
  <PageHero
    kicker="Recursos"
    title="Guías escritas desde proyectos reales."
    lead="Guías prácticas sobre desarrollo de software, migración de sistemas y datos, escritas con lo que hemos aprendido construyendo proyectos reales."
  />

  <section class="py-16 md:py-24 px-4 md:px-8 bg-neutral-50">
    <div class="max-w-7xl mx-auto">
      {
        whitepapers.length === 0 ? (
          <div class="py-20 text-center border-2 border-dashed border-neutral-200">
            <p class="text-lg text-neutral-900 max-w-xl mx-auto">
              Todavía no tenemos guías publicadas. ¿Buscas algo puntual? Cuéntanos qué necesitas —{' '}
              <a
                href="/contacto"
                class="font-bold text-secondary underline decoration-interactive decoration-2 underline-offset-4"
              >
                contáctanos
              </a>
              .
            </p>
          </div>
        ) : (
          <ul class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-px bg-neutral-200 border border-neutral-200 list-none p-0 m-0">
            {whitepapers.map((whitepaper) => (
              <li class="bg-white">
                <div class="flex h-full min-h-72 flex-col gap-4 p-8">
                  {/* Ícono de documento/descarga: no existe un concepto equivalente
                      entre los 7 íconos de Icon.astro (ver AGENTS.md, revisado contra
                      el Tablero de Marca antes de asumirlo). Se mantiene como SVG local
                      a esta card, en el mismo estilo de trazo (stroke, currentColor,
                      viewBox 24x24) en vez de agregarse al set compartido sin esa
                      confirmación. */}
                  <svg
                    class="w-10 h-10 text-primary"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.9"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M6 3.5h8l4 4v13a1 1 0 01-1 1H6a1 1 0 01-1-1v-16a1 1 0 011-1z" />
                    <path d="M14 3.5v4h4" />
                    <path d="M12 11v6M9.3 14.3L12 17l2.7-2.7" />
                  </svg>
                  <h2 class="font-heading text-2xl font-extrabold tracking-tight leading-tight text-secondary text-balance">
                    {whitepaper.title}
                  </h2>
                  {whitepaper.summary && (
                    <p class="text-neutral-900 leading-relaxed flex-grow">{whitepaper.summary}</p>
                  )}
                  {whitepaper.targetRole && (
                    <div>
                      <PendingContentTag label="Rol objetivo" />
                    </div>
                  )}
                  <Button
                    size="sm"
                    class="whitepaper-download-trigger mt-2 self-start"
                    data-whitepaper-id={whitepaper._id}
                    data-whitepaper-title={whitepaper.title}
                  >
                    Descargar
                  </Button>
                </div>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </section>

  <WhitepaperGateModal />
</BaseLayout>
