---
export const prerender = true;

import BaseLayout from '../../layouts/BaseLayout.astro';
import { client } from '../../lib/sanity';
import PendingContentTag from '../../components/PendingContentTag.astro';
import WhitepaperGateModal from '../../components/WhitepaperGateModal.astro';
import type { WhitepaperSchema } from '../../types/sanity';

// Proyección explícita: nunca se incluye `pdfFile` aquí. El _ref de un asset
// `file` de Sanity permite reconstruir su URL de descarga sin dereferenciarlo,
// así que traerlo a esta página prerenderizada ya sería filtrar el PDF antes
// de que alguien complete el formulario de /api/whitepaper-download.ts.
let whitepapers: WhitepaperSchema[] = [];

try {
  whitepapers = await client.fetch<WhitepaperSchema[]>(
    `*[_type == "whitepaper"] | order(title asc){_id, title, slug, summary, targetRole}`,
  );
} catch (error) {
  console.error('Error fetching whitepapers from Sanity:', error);
}

if (!whitepapers) {
  whitepapers = [];
}
---

<BaseLayout
  title="Recursos"
  description="Guías prácticas sobre desarrollo de software, migración de sistemas y datos, escritas con lo que hemos aprendido construyendo proyectos reales."
>
  <header class="bg-secondary text-white py-24 md:py-32 px-4 md:px-8 border-b-8 border-accent">
    <div class="max-w-7xl mx-auto">
      <h1 class="text-4xl md:text-6xl font-heading mb-6 tracking-tight text-white">Recursos</h1>
      <p class="text-xl md:text-2xl text-neutral-300 max-w-3xl leading-relaxed">
        Guías prácticas sobre desarrollo de software, migración de sistemas y datos, escritas con
        lo que hemos aprendido construyendo proyectos reales.
      </p>
    </div>
  </header>

  <section class="py-24 px-4 md:px-8 bg-neutral-50">
    <div class="max-w-7xl mx-auto">
      {
        whitepapers.length === 0 ? (
          <div class="text-center py-24 border-2 border-dashed border-neutral-200">
            <p class="text-lg text-neutral-600 max-w-xl mx-auto">
              Todavía no tenemos guías publicadas. ¿Buscas algo puntual? Cuéntanos qué necesitas —{' '}
              <a href="/contacto" class="text-interactive font-bold underline">
                contáctanos
              </a>
              .
            </p>
          </div>
        ) : (
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {whitepapers.map((whitepaper) => (
              <div class="border-2 border-neutral-200 bg-white p-8 flex flex-col gap-4 hover:border-primary transition-colors duration-300">
                {/* Ícono placeholder de documento/descarga: no existe un concepto
                    equivalente entre los 7 íconos de Icon.astro (ver AGENTS.md,
                    revisado contra el Tablero de Marca antes de asumirlo). Se
                    mantiene como SVG local a esta card, en el mismo estilo de
                    trazo (stroke, currentColor, viewBox 24x24) en vez de
                    agregarse al set compartido sin esa confirmación. */}
                <svg
                  class="w-10 h-10 text-primary"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.9"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M6 3.5h8l4 4v13a1 1 0 01-1 1H6a1 1 0 01-1-1v-16a1 1 0 011-1z" />
                  <path d="M14 3.5v4h4" />
                  <path d="M12 11v6M9.3 14.3L12 17l2.7-2.7" />
                </svg>
                <h2 class="text-2xl font-heading text-secondary leading-tight">
                  {whitepaper.title}
                </h2>
                {whitepaper.summary && (
                  <p class="text-sm text-neutral-600 leading-relaxed flex-grow">
                    {whitepaper.summary}
                  </p>
                )}
                {whitepaper.targetRole && (
                  <div>
                    <PendingContentTag label="Rol objetivo" />
                  </div>
                )}
                <button
                  type="button"
                  class="whitepaper-download-trigger mt-2 w-full md:w-auto self-start px-6 py-3 bg-primary hover:bg-interactive text-white font-bold text-sm tracking-widest uppercase transition-colors"
                  data-whitepaper-id={whitepaper._id}
                  data-whitepaper-title={whitepaper.title}
                >
                  Descargar
                </button>
              </div>
            ))}
          </div>
        )
      }
    </div>
  </section>

  <WhitepaperGateModal />
</BaseLayout>
