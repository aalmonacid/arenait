---
export const prerender = true;

import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { client } from '../../lib/sanity';
import { fallbackServices } from '../../lib/fallbackContent';
import type { ServiceSchema } from '../../types/sanity';

let services: ServiceSchema[] = [];

try {
  services = await client.fetch<ServiceSchema[]>(`*[_type == "service"]`);
} catch (error) {
  console.error('Error fetching services from Sanity:', error);
}

if (!services || services.length === 0) {
  services = fallbackServices;
}
---

<BaseLayout
  title="Servicios"
  description="Trabajamos el ciclo completo de una solución de software: desde el desarrollo a la medida, hasta que quede operando y se mantenga funcionando en el tiempo."
>
  <header class="bg-secondary text-white py-24 md:py-32 px-4 md:px-8 border-b-8 border-accent">
    <div class="max-w-7xl mx-auto">
      <h1 class="text-4xl md:text-6xl font-heading mb-6 tracking-tight text-white">Servicios</h1>
      <p class="text-xl md:text-2xl text-neutral-300 max-w-3xl leading-relaxed">
        Trabajamos el ciclo completo de una solución de software: desde el desarrollo a la medida,
        hasta que quede operando y se mantenga funcionando en el tiempo.
      </p>
    </div>
  </header>

  <section class="py-24 px-4 md:px-8 bg-neutral-50">
    <div class="max-w-7xl mx-auto space-y-8">
      {
        services.map((service) => (
          <div
            id={service.slug?.current}
            class="bg-white border-2 border-neutral-200 p-8 md:p-12 grid grid-cols-1 md:grid-cols-[auto_1fr_auto] md:items-center gap-6"
          >
            {service.icon && (
              <div class="text-primary">
                <Icon name={service.icon as any} class="w-10 h-10" />
              </div>
            )}
            <div>
              <h2 class="text-2xl md:text-3xl font-heading text-secondary mb-3">{service.title}</h2>
              <p class="text-neutral-900 leading-relaxed max-w-2xl">{service.description}</p>
            </div>
            <a
              href={`/contacto?servicio=${encodeURIComponent(service.title)}`}
              class="inline-flex justify-center items-center px-6 py-3 bg-primary hover:bg-interactive text-white font-bold tracking-widest uppercase text-sm transition-colors whitespace-nowrap"
            >
              Hablemos de este servicio
            </a>
          </div>
        ))
      }
    </div>
  </section>
</BaseLayout>
