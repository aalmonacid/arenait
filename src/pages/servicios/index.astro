---
export const prerender = true;

import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import PageHero from '../../components/PageHero.astro';
import Button from '../../components/Button.astro';
import { getServices } from '../../lib/services';

// Servicios: Sanity con respaldo en el código y orden por el campo `order` (src/lib/services.ts).
const services = await getServices();

// JSON-LD: cada servicio real como Service dentro de un ItemList — sin
// inventar campos que no existen en el schema (nada de precio/rating/reviews).
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    itemListElement: services.map((service, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      item: {
        '@type': 'Service',
        name: service.title,
        description: service.description,
        url: new URL(`/servicios#${service.slug?.current ?? ''}`, Astro.site).toString(),
        provider: {
          '@type': 'Organization',
          name: 'ArenaIT',
          url: 'https://arenait.co',
        },
      },
    })),
  },
];
---

<BaseLayout
  title="Servicios"
  description="Trabajamos el ciclo completo de una solución de software: desde el desarrollo a la medida, hasta que quede operando y se mantenga funcionando en el tiempo."
  structuredData={structuredData}
>
  <PageHero
    kicker="Servicios"
    title="Todo el ciclo de una solución de software."
    lead="Trabajamos el ciclo completo de una solución de software: desde el desarrollo a la medida, hasta que quede operando y se mantenga funcionando en el tiempo."
  />

  <section class="py-16 md:py-24 px-4 md:px-8 bg-neutral-50">
    <div class="max-w-7xl mx-auto">
      <ul class="list-none p-0 m-0 border-t-2 border-neutral-900">
        {
          services.map((service) => (
            <li id={service.slug?.current} class="border-b border-neutral-200">
              <article class="grid grid-cols-1 md:grid-cols-12 gap-x-6 gap-y-5 py-10 md:py-12 items-start">
                <div class="md:col-span-1 text-primary">
                  {service.icon && <Icon name={service.icon as any} class="w-10 h-10" />}
                </div>
                <h2 class="md:col-span-4 font-heading text-2xl md:text-3xl font-extrabold tracking-tight leading-tight text-secondary text-balance">
                  {service.title}
                </h2>
                <p class="md:col-span-5 text-neutral-900 leading-relaxed">{service.description}</p>
                <div class="md:col-span-2 md:text-right">
                  <Button
                    variant="line"
                    size="sm"
                    href={`/contacto?servicio=${encodeURIComponent(service.title)}`}
                  >
                    Hablemos
                  </Button>
                </div>
              </article>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>
