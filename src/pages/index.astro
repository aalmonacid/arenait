---
export const prerender = true;

import { getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import ServicesBento from '../components/ServicesBento.astro';
import Testimonials from '../components/Testimonials.astro';
import SectionHead from '../components/SectionHead.astro';
import ProcessFlow from '../components/ProcessFlow.astro';
import DotsMotif from '../components/DotsMotif.astro';
import { client } from '../lib/sanity';
import { fallbackServices, fallbackCaseStudies } from '../lib/fallbackContent';
import type { ServiceSchema } from '../types/sanity';
import heroImage from '../assets/images/hero-facade.jpg';

let services: ServiceSchema[] = [];

try {
  services = await client.fetch<ServiceSchema[]>(`*[_type == "service"]`);
} catch (error) {
  console.error('Error fetching services from Sanity:', error);
}

if (!services || services.length === 0) {
  services = fallbackServices;
}

// Caso real de Sadep: misma fuente de contenido que /casos-de-estudio.
const sadep = fallbackCaseStudies[0];

// Sectores de experiencia: contenido real migrado del sitio anterior (ver /nosotros).
const sectors = ['Financiero', 'Asegurador', 'Servicios', 'Agropecuario'];

// ogImage (Épica K de BACKLOG.md): se deriva una copia estática 1200x630 de la
// foto real del hero anterior vía getImage(). El hero rediseñado (12/11/2026)
// ya no muestra la foto, pero sigue siendo la mejor imagen real para compartir.
const ogImage = await getImage({
  src: heroImage,
  width: 1200,
  height: 630,
  fit: 'cover',
  format: 'jpg',
  quality: 70,
});
---

<BaseLayout
  title="Software a la medida para operaciones reales"
  description="Diseñamos, desarrollamos e integramos soluciones tecnológicas que se ajustan a cómo trabaja tu empresa — no al revés."
  ogImage={ogImage.src}
>
  <!-- Hero editorial: tipografía como protagonista sobre una retícula visible.
       Sin foto ni scrim: el motivo gráfico es la fila de puntos del logo. -->
  <section class="relative overflow-hidden bg-white pt-16 md:pt-28" aria-labelledby="hero-title">
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <div class="h-full max-w-7xl mx-auto px-4 md:px-8 grid grid-cols-2 md:grid-cols-4">
        <span class="border-l border-neutral-200"></span>
        <span class="border-l border-neutral-200 md:border-l"></span>
        <span class="hidden md:block border-l border-neutral-200"></span>
        <span class="hidden md:block border-l border-r border-neutral-200"></span>
      </div>
    </div>

    <div class="relative max-w-7xl mx-auto px-4 md:px-8">
      <p
        class="flex items-center gap-4 text-xs font-bold uppercase tracking-label text-secondary mb-7 before:block before:h-0.5 before:w-12 before:bg-neutral-900"
      >
        Desarrollo de software a la medida
      </p>
      <h1 id="hero-title" class="font-heading text-display max-w-display text-neutral-900">
        Software a la medida para operaciones <em
          class="not-italic relative whitespace-nowrap after:absolute after:left-0 after:right-0 after:-bottom-1 after:h-1.5 md:after:h-2.5 after:bg-accent after:origin-left motion-safe:after:animate-draw"
          >reales.</em
        >
      </h1>

      <div class="grid grid-cols-1 md:grid-cols-12 gap-x-6 gap-y-8 py-12 md:py-20">
        <p
          class="md:col-span-5 self-start border-t-2 border-neutral-900 pt-4 text-xs font-bold uppercase tracking-label text-secondary"
        >
          Del diseño al mantenimiento en producción
        </p>
        <div class="md:col-span-6 md:col-start-7">
          <p class="text-lead text-neutral-900 max-w-xl mb-8">
            Diseñamos, desarrollamos e integramos soluciones tecnológicas que se ajustan a cómo
            trabaja tu empresa — no al revés.
          </p>
          <div class="flex flex-col sm:flex-row gap-3">
            <a
              href="/contacto"
              class="inline-flex min-h-14 items-center justify-center border-2 border-accent bg-accent px-7 text-xs font-extrabold uppercase tracking-label text-neutral-900 transition-colors hover:border-neutral-900 hover:bg-neutral-900 hover:text-white focus-visible:outline focus-visible:outline-4 focus-visible:outline-offset-4 focus-visible:outline-interactive"
            >
              Cuéntanos tu reto
            </a>
            <a
              href="#como-trabajamos"
              class="inline-flex min-h-14 items-center justify-center border-2 border-neutral-900 px-7 text-xs font-extrabold uppercase tracking-label text-neutral-900 transition-colors hover:border-interactive focus-visible:outline focus-visible:outline-4 focus-visible:outline-offset-4 focus-visible:outline-interactive"
            >
              Ver cómo trabajamos
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Franja de navegación interna + motivo de marca -->
    <div class="relative border-y border-neutral-200 bg-white">
      <div
        class="max-w-7xl mx-auto px-4 md:px-8 py-4 flex flex-wrap items-center justify-between gap-4"
      >
        <ul
          class="flex flex-wrap gap-x-8 gap-y-1 list-none p-0 m-0 text-xs font-bold uppercase tracking-label text-secondary"
        >
          <li>
            <a href="#servicios" class="border-b-2 border-transparent py-1 hover:border-interactive"
              >Servicios</a
            >
          </li>
          <li>
            <a
              href="#como-trabajamos"
              class="border-b-2 border-transparent py-1 hover:border-interactive">Cómo trabajamos</a
            >
          </li>
          <li>
            <a href="#caso" class="border-b-2 border-transparent py-1 hover:border-interactive"
              >Caso</a
            >
          </li>
          <li>
            <a href="#sectores" class="border-b-2 border-transparent py-1 hover:border-interactive"
              >Sectores</a
            >
          </li>
        </ul>
        <DotsMotif />
      </div>
    </div>
  </section>

  <section
    id="servicios"
    class="py-20 md:py-32 px-4 md:px-8 bg-neutral-50"
    aria-labelledby="servicios-title"
  >
    <div class="max-w-7xl mx-auto">
      <SectionHead
        id="servicios-title"
        label="Servicios"
        title="Un solo equipo para todo el ciclo del software."
      />
      <ServicesBento services={services} />
      <p class="mt-8">
        <a
          href="/servicios"
          class="inline-block border-b-2 border-neutral-900 py-1 text-xs font-extrabold uppercase tracking-label text-neutral-900 hover:border-interactive"
        >
          Ver el detalle de todos los servicios
        </a>
      </p>
    </div>
  </section>

  <section
    id="como-trabajamos"
    class="py-20 md:py-32 px-4 md:px-8 bg-secondary text-white"
    aria-labelledby="proceso-title"
  >
    <div class="max-w-7xl mx-auto">
      <SectionHead
        id="proceso-title"
        variant="dark"
        label="Cómo trabajamos"
        title="Te acompañamos desde el diseño hasta que el sistema opera."
      />
      <ProcessFlow />
      <div
        class="mt-12 border-2 border-white p-5 md:px-6 flex flex-col md:flex-row md:items-baseline gap-2 md:gap-8"
      >
        <p class="text-xs font-bold uppercase tracking-label text-white">Transversal</p>
        <p class="text-white">
          Gestión de proyectos de TI: metodología clara, alcance definido y comunicación constante
          en todo el ciclo.
        </p>
      </div>
    </div>
  </section>

  <section id="caso" class="py-20 md:py-32 px-4 md:px-8 bg-white" aria-labelledby="caso-title">
    <div class="max-w-7xl mx-auto">
      <SectionHead
        id="caso-title"
        label="Caso de éxito"
        title={`${sadep.client} — ${sadep.title}`}
      />
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-x-6 gap-y-10">
        <aside class="lg:col-span-4 lg:self-start lg:sticky lg:top-8">
          <p class="text-xs font-bold uppercase tracking-label text-secondary">{sadep.client}</p>
          <p
            class="font-heading text-2xl md:text-3xl font-extrabold tracking-tight leading-tight text-secondary mt-3 mb-6"
          >
            Dos plataformas a la medida para operar fincas a distancia.
          </p>
          <dl class="border-t border-neutral-200 text-sm">
            <div class="flex justify-between gap-4 py-3 border-b border-neutral-200">
              <dt class="font-bold text-secondary">Sector</dt>
              <dd class="text-right text-neutral-900">{sadep.industry}</dd>
            </div>
            <div class="flex justify-between gap-4 py-3 border-b border-neutral-200">
              <dt class="font-bold text-secondary">Plataformas</dt>
              <dd class="text-right text-neutral-900">Tauruswebs · Oviswebs</dd>
            </div>
          </dl>
        </aside>
        <div class="lg:col-span-7 lg:col-start-6">
          <div
            class="border-t-2 border-neutral-900 py-7 grid grid-cols-1 md:grid-cols-[9.5rem_1fr] gap-x-6 gap-y-2"
          >
            <p class="text-xs font-bold uppercase tracking-label text-secondary pt-1">El reto</p>
            <p class="text-neutral-900 leading-relaxed">{sadep.challenge}</p>
          </div>
          <div
            class="border-t border-neutral-200 py-7 grid grid-cols-1 md:grid-cols-[9.5rem_1fr] gap-x-6 gap-y-2"
          >
            <p class="text-xs font-bold uppercase tracking-label text-secondary pt-1">
              Lo que construimos
            </p>
            <p class="text-neutral-900 leading-relaxed">{sadep.solution}</p>
          </div>
          <div
            class="border-t border-neutral-200 border-l-8 border-l-accent bg-neutral-50 p-7 grid grid-cols-1 md:grid-cols-[9.5rem_1fr] gap-x-6 gap-y-2"
          >
            <p class="text-xs font-bold uppercase tracking-label text-secondary pt-1">Resultado</p>
            <p class="text-neutral-900 leading-relaxed">{sadep.results?.[0]}</p>
          </div>
          <a
            href="/casos-de-estudio/sadep"
            class="mt-8 inline-block border-b-2 border-neutral-900 py-1 text-xs font-extrabold uppercase tracking-label text-neutral-900 hover:border-interactive"
          >
            Ver caso completo
          </a>
        </div>
      </div>
    </div>
  </section>

  <section
    id="sectores"
    class="py-20 md:py-32 px-4 md:px-8 bg-neutral-50"
    aria-labelledby="sectores-title"
  >
    <div class="max-w-7xl mx-auto">
      <SectionHead
        id="sectores-title"
        label="Experiencia"
        title="Sectores en los que hemos trabajado."
      />
      <ul
        class="grid grid-cols-2 lg:grid-cols-4 gap-px bg-neutral-200 border border-neutral-200 list-none p-0 m-0"
        aria-label="Sectores de experiencia"
      >
        {
          sectors.map((sector) => (
            <li class="bg-white p-6 pb-10 before:block before:h-1 before:w-8 before:bg-accent before:mb-6">
              <p class="font-heading text-xl md:text-2xl font-extrabold tracking-tight text-secondary">
                {sector}
              </p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <Testimonials />

  <section
    class="bg-accent text-neutral-900 py-20 md:py-28 px-4 md:px-8"
    aria-labelledby="cta-title"
  >
    <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-12 gap-x-6 gap-y-8 items-end">
      <h2
        id="cta-title"
        class="md:col-span-8 font-heading text-headline-xl max-w-headline text-balance"
      >
        ¿Tienes un reto operativo que el software puede resolver?
      </h2>
      <div class="md:col-span-4 flex flex-col gap-5 items-start">
        <p class="text-lg">Cuéntanos qué necesitas. Te respondemos con una propuesta concreta.</p>
        <a
          href="/contacto"
          class="inline-flex min-h-14 items-center justify-center border-2 border-neutral-900 bg-neutral-900 px-7 text-xs font-extrabold uppercase tracking-label text-white transition-colors hover:bg-white hover:text-neutral-900 focus-visible:outline focus-visible:outline-4 focus-visible:outline-offset-4 focus-visible:outline-neutral-900"
        >
          Cuéntanos tu reto
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
