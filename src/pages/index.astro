---
export const prerender = true;

import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import ServiceCard from '../components/ServiceCard.astro';
import Testimonials from '../components/Testimonials.astro';
import { client } from '../lib/sanity';
import { fallbackServices } from '../lib/fallbackContent';
import type { ServiceSchema } from '../types/sanity';
import heroImage from '../assets/images/hero-facade.jpg';

let services: ServiceSchema[] = [];

try {
  services = await client.fetch<ServiceSchema[]>(`*[_type == "service"]`);
} catch (error) {
  console.error('Error fetching services from Sanity:', error);
}

if (!services || services.length === 0) {
  services = fallbackServices;
}

const pillars = [
  {
    icon: 'code' as const,
    title: 'Desarrollo a la medida',
    description:
      'Construimos el sistema exacto que tu operación necesita, diseñado desde cero — no una plantilla forzada a encajar.',
  },
  {
    icon: 'shield-check' as const,
    title: 'Aseguramiento de calidad',
    description:
      'Probamos cada entrega antes de que llegue a tus usuarios, para que los errores se resuelvan en desarrollo, no en producción.',
  },
  {
    icon: 'chart' as const,
    title: 'Business Intelligence',
    description:
      'Convertimos los datos que ya genera tu operación en indicadores que realmente se usan para decidir.',
  },
  {
    icon: 'refresh' as const,
    title: 'Mantenimiento y evolución',
    description:
      'El software vivo cambia contigo. Damos mantenimiento, actualizamos y migramos lo que ya construiste para que siga funcionando.',
  },
];
---

<BaseLayout
  title="Software a la medida para operaciones reales"
  description="Diseñamos, desarrollamos e integramos soluciones tecnológicas que se ajustan a cómo trabaja tu empresa — no al revés."
>
  <section class="relative overflow-hidden bg-secondary text-white py-24 md:py-32 px-4 md:px-8 border-b-8 border-accent">
    <Image
      src={heroImage}
      alt=""
      class="absolute inset-0 w-full h-full object-cover opacity-60"
      widths={[640, 1080, 1600, 2000]}
      sizes="100vw"
      loading="eager"
      quality={70}
    />
    <div class="absolute inset-0 hero-scrim"></div>
    <div class="max-w-7xl mx-auto relative">
      <p class="text-sm font-bold tracking-widest uppercase text-accent mb-6">
        Desarrollo de software a la medida
      </p>
      <h1 class="text-5xl md:text-7xl font-heading leading-tight mb-8 max-w-4xl">
        Software a la medida para operaciones reales.
      </h1>
      <p class="text-xl md:text-2xl text-neutral-300 max-w-3xl mb-12 leading-relaxed">
        Diseñamos, desarrollamos e integramos soluciones tecnológicas que se ajustan a cómo trabaja
        tu empresa — no al revés.
      </p>
      <div class="flex flex-col sm:flex-row gap-4">
        <a
          href="/contacto"
          class="inline-flex justify-center items-center px-8 py-4 bg-primary text-white font-bold tracking-widest uppercase hover:bg-interactive transition-colors"
        >
          Cuéntanos tu reto
        </a>
        <a
          href="/servicios"
          class="inline-flex justify-center items-center px-8 py-4 bg-transparent border-2 border-white text-white font-bold tracking-widest uppercase hover:bg-white hover:text-neutral-900 transition-colors"
        >
          Ver cómo trabajamos
        </a>
      </div>
    </div>
  </section>

  <section class="py-24 md:py-32 px-4 md:px-8 bg-white">
    <div class="max-w-7xl mx-auto">
      <h2 class="text-4xl md:text-5xl font-heading text-secondary mb-16 max-w-3xl">
        En qué te ayudamos
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        {
          pillars.map((pillar) => (
            <div>
              <div class="text-primary mb-4">
                <Icon name={pillar.icon} />
              </div>
              <h3 class="text-xl font-heading text-secondary mb-3">{pillar.title}</h3>
              <p class="text-neutral-900 leading-relaxed">{pillar.description}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section id="servicios" class="py-24 md:py-32 px-4 md:px-8 bg-neutral-50">
    <div class="max-w-7xl mx-auto">
      <div class="mb-16 max-w-3xl flex flex-col md:flex-row md:items-end md:justify-between gap-6">
        <h2 class="text-4xl md:text-5xl font-heading text-secondary">Servicios</h2>
        <a href="/servicios" class="text-interactive font-bold underline">
          Ver el detalle de todos los servicios
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {services.map((service) => <ServiceCard service={service} />)}
      </div>
    </div>
  </section>

  <section class="py-24 px-4 md:px-8 bg-white border-t border-neutral-200">
    <div class="max-w-7xl mx-auto">
      <p class="text-sm font-bold tracking-widest uppercase text-interactive mb-4">Caso de éxito</p>
      <h2 class="text-3xl md:text-4xl font-heading text-secondary mb-10 max-w-3xl">
        SADEP LTDA — Gestión remota de fincas ganaderas
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-10">
        <div>
          <p class="text-sm font-bold tracking-widest uppercase text-neutral-500 mb-2">El reto</p>
          <p class="text-neutral-900 leading-relaxed">
            Sadep necesitaba centralizar la captura de datos, la generación de indicadores y la
            simulación de producción en operaciones ganaderas dispersas, sin depender de procesos
            manuales.
          </p>
        </div>
        <div>
          <p class="text-sm font-bold tracking-widest uppercase text-neutral-500 mb-2">
            Lo que construimos
          </p>
          <p class="text-neutral-900 leading-relaxed">
            Dos plataformas a la medida — Tauruswebs (ganado bovino) y Oviswebs (ganado
            ovino-caprino) — para captura de datos, gestión de producción, generación de indicadores
            y simulación, con administración remota de finca.
          </p>
        </div>
        <div>
          <p class="text-sm font-bold tracking-widest uppercase text-neutral-500 mb-2">Resultado</p>
          <p class="text-neutral-900 leading-relaxed">
            Sadep opera y supervisa sus fincas de forma remota, con datos centralizados y trazables
            en un solo sistema.
          </p>
        </div>
      </div>
      <a
        href="/casos-de-estudio/sadep"
        class="inline-block mt-10 text-interactive font-bold underline"
      >
        Ver caso completo
      </a>
    </div>
  </section>

  <Testimonials />

  <section class="py-24 px-4 md:px-8 bg-neutral-50 border-t border-neutral-200">
    <div class="max-w-4xl mx-auto text-center">
      <h2 class="text-3xl md:text-4xl font-heading text-secondary mb-4">
        ¿Tienes un reto operativo que el software puede resolver?
      </h2>
      <p class="text-lg text-neutral-900 mb-8">
        Cuéntanos qué necesitas. Te respondemos con una propuesta concreta.
      </p>
      <a
        href="/contacto"
        class="inline-flex justify-center items-center px-8 py-4 bg-primary hover:bg-interactive text-white font-bold tracking-widest uppercase transition-colors"
      >
        Cuéntanos tu reto
      </a>
    </div>
  </section>
</BaseLayout>
