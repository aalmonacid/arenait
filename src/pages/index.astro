---
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';
import PillarCards from '../components/PillarCards.astro';
import Testimonials from '../components/Testimonials.astro';
import SectionHead from '../components/SectionHead.astro';
import ProcessFlow from '../components/ProcessFlow.astro';
import DotsMotif from '../components/DotsMotif.astro';
import SectorGrid from '../components/SectorGrid.astro';
import ClosingCta from '../components/ClosingCta.astro';
import Button from '../components/Button.astro';
import { getHomePage, getProjects, getSiteSettings } from '../lib/content';
import { buildWhatsappUrl } from '../lib/contact';

const [home, settings, projects] = await Promise.all([
  getHomePage(),
  getSiteSettings(),
  getProjects(),
]);

// Proyectos destacados del inicio (marcados en Sanity), por `homeOrder`
// (el sort es estable: los sin orden conservan el orden del sitio).
const featured = projects
  .filter((p) => p.featuredOnHome)
  .sort((a, b) => (a.homeOrder ?? Infinity) - (b.homeOrder ?? Infinity))
  .slice(0, 3);
const sectorLabel = (key: string) => settings.sectors.find((s) => s.key === key)?.label ?? key;

// Subrayado del final del titular («reales.»), solo si coincide con el cierre del texto.
const highlight = home.heroTitleHighlight;
const titleHasHighlight = Boolean(highlight && home.heroTitle.endsWith(highlight));
const titleLead = titleHasHighlight
  ? home.heroTitle.slice(0, home.heroTitle.length - (highlight as string).length)
  : home.heroTitle;

// Imagen para compartir: archivo estático 1200x630 derivado con
// `node scripts/make-images.mjs` (el adaptador de Cloudflare usa `passthrough`).
const ogImage = '/og-home.jpg';
---

<BaseLayout title={home.seoTitle} description={home.seoDescription} ogImage={ogImage}>
  <!-- Hero editorial: tipografía como protagonista sobre una retícula visible.
       Sin foto ni scrim: el motivo gráfico es la fila de puntos del logo. -->
  <section class="relative overflow-hidden bg-white pt-16 md:pt-28" aria-labelledby="hero-title">
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <div class="h-full max-w-7xl mx-auto px-4 md:px-8 grid grid-cols-2 md:grid-cols-4">
        <span class="border-l border-neutral-200"></span>
        <span class="border-l border-neutral-200 md:border-l"></span>
        <span class="hidden md:block border-l border-neutral-200"></span>
        <span class="hidden md:block border-l border-r border-neutral-200"></span>
      </div>
    </div>

    <div class="relative max-w-7xl mx-auto px-4 md:px-8">
      <p
        class="flex items-center gap-4 text-xs font-bold uppercase tracking-label text-secondary mb-7 before:block before:h-0.5 before:w-12 before:bg-neutral-900"
      >
        {home.heroEyebrow}
      </p>
      <h1 id="hero-title" class="font-heading text-display max-w-display text-neutral-900">
        {titleLead}{
          titleHasHighlight && (
            <em class="not-italic relative whitespace-nowrap after:absolute after:left-0 after:right-0 after:-bottom-1 after:h-1.5 md:after:h-2.5 after:bg-accent after:origin-left motion-safe:after:animate-draw">
              {highlight}
            </em>
          )
        }
      </h1>

      <div class="grid grid-cols-1 md:grid-cols-12 gap-x-6 gap-y-8 py-12 md:py-20">
        <div class="md:col-span-6 md:col-start-7">
          <p class="text-lead text-neutral-900 max-w-xl mb-8">{home.heroIntro}</p>
          <div class="flex flex-col sm:flex-row gap-3">
            <Button href={home.heroPrimaryCta.href}>{home.heroPrimaryCta.label}</Button>
            <Button href={home.heroSecondaryCta.href} variant="line">
              {home.heroSecondaryCta.label}
            </Button>
          </div>
        </div>
      </div>
    </div>

    <!-- Franja de accesos rápidos + motivo de marca -->
    <div class="relative border-y border-neutral-200 bg-white">
      <div
        class="max-w-7xl mx-auto px-4 md:px-8 py-3 flex flex-wrap items-center justify-between gap-4"
      >
        <nav aria-label="Accesos rápidos">
          <ul
            class="flex flex-wrap gap-x-8 gap-y-1 list-none p-0 m-0 text-xs font-bold uppercase tracking-label text-secondary"
          >
            {
              home.quickLinks.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="inline-flex min-h-11 items-center border-b-2 border-transparent hover:border-interactive"
                  >
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <DotsMotif />
      </div>
    </div>
  </section>

  <section
    id="servicios"
    class="scroll-mt-6 py-20 md:py-32 px-4 md:px-8 bg-neutral-50"
    aria-labelledby="servicios-title"
  >
    <div class="max-w-7xl mx-auto">
      <SectionHead id="servicios-title" label="Servicios" title={home.servicesTitle} />
      <PillarCards pillars={home.pillars} linkLabel={home.pillarLinkLabel} />
      <p class="mt-8">
        <a
          href={home.allServicesLink.href}
          class="inline-flex min-h-11 items-center border-b-2 border-neutral-900 text-xs font-extrabold uppercase tracking-label text-neutral-900 hover:border-interactive"
        >
          {home.allServicesLink.label}
        </a>
      </p>
    </div>
  </section>

  <section
    id="como-trabajamos"
    class="scroll-mt-6 py-20 md:py-32 px-4 md:px-8 bg-secondary text-white"
    aria-labelledby="proceso-title"
  >
    <div class="max-w-7xl mx-auto">
      <SectionHead
        id="proceso-title"
        variant="dark"
        label="Cómo trabajamos"
        title={home.processTitle}
      />
      <ProcessFlow steps={home.processSteps} />
      <p class="mt-12">
        <a
          href={home.processLink.href}
          class="inline-flex min-h-11 items-center border-b-2 border-white text-xs font-extrabold uppercase tracking-label text-white hover:border-accent focus-visible:outline-white"
        >
          {home.processLink.label}
        </a>
      </p>
    </div>
  </section>

  {
    featured.length > 0 && (
      <section
        id="proyectos"
        class="scroll-mt-6 py-20 md:py-32 px-4 md:px-8 bg-white"
        aria-labelledby="proyectos-title"
      >
        <div class="max-w-7xl mx-auto">
          <SectionHead id="proyectos-title" label="Proyectos" title={home.projectsTitle} />
          <ul class="grid grid-cols-1 lg:grid-cols-3 gap-6 list-none p-0 m-0">
            {featured.map((project) => (
              <li>
                <article class="h-full border border-neutral-200 border-t-4 border-t-secondary bg-white p-6 md:p-8">
                  <h3 class="font-heading text-xl md:text-2xl font-extrabold tracking-tight leading-tight text-secondary text-balance">
                    {project.title}
                  </h3>
                  <p class="mt-3 text-sm font-bold text-secondary">
                    {project.client} · {sectorLabel(project.sector)}
                  </p>
                  <p class="mt-4 leading-relaxed text-neutral-900">
                    {project.homeSummary ?? project.result}
                  </p>
                </article>
              </li>
            ))}
          </ul>
          <p class="mt-8">
            <a
              href={home.projectsLink.href}
              class="inline-flex min-h-11 items-center border-b-2 border-neutral-900 text-xs font-extrabold uppercase tracking-label text-neutral-900 hover:border-interactive"
            >
              {home.projectsLink.label}
            </a>
          </p>
        </div>
      </section>
    )
  }

  <section
    id="sectores"
    class="scroll-mt-6 py-20 md:py-32 px-4 md:px-8 bg-neutral-50"
    aria-labelledby="sectores-title"
  >
    <div class="max-w-7xl mx-auto">
      <SectionHead id="sectores-title" label="Sectores" title={home.sectorsTitle} />
      <SectorGrid sectors={settings.sectors} />
    </div>
  </section>

  <Testimonials />

  <ClosingCta
    title={home.closingTitle}
    text={home.closingText}
    links={home.closingLinks}
    whatsappLabel={home.closingWhatsappLabel}
    whatsappUrl={buildWhatsappUrl(settings.whatsappNumber, settings.whatsappMessage)}
  />
</BaseLayout>
