---
export const prerender = true;

import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';

const posts = (await getCollection('blog')).sort(
  (a: CollectionEntry<'blog'>, b: CollectionEntry<'blog'>) =>
    b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
);

function formatDate(date: Date): string {
  return date.toLocaleDateString('es-CO', { year: 'numeric', month: 'long', day: 'numeric' });
}
---

<BaseLayout
  title="Blog"
  description="Artículos sobre desarrollo de software a la medida, modernización de sistemas y buenas prácticas de TI para empresas."
>
  <PageHero
    kicker="Blog"
    title="Ideas y prácticas reales de software."
    lead="Ideas y prácticas reales sobre desarrollo de software, modernización de sistemas y TI para empresas."
  />

  <section class="py-16 md:py-24 px-4 md:px-8 bg-neutral-50">
    <div class="max-w-7xl mx-auto">
      {
        posts.length === 0 ? (
          <div class="py-20 text-center border-2 border-dashed border-neutral-200">
            <p class="text-lg text-neutral-900 max-w-xl mx-auto">
              Todavía no hay artículos publicados. Estamos preparando el primer contenido —{' '}
              <a
                href="/contacto"
                class="font-bold text-secondary underline decoration-interactive decoration-2 underline-offset-4"
              >
                escríbenos
              </a>{' '}
              si quieres que cubramos un tema puntual.
            </p>
          </div>
        ) : (
          <ul class="grid grid-cols-1 md:grid-cols-2 gap-px bg-neutral-200 border border-neutral-200 list-none p-0 m-0">
            {posts.map((post: CollectionEntry<'blog'>) => (
              <li class="bg-white">
                <a
                  href={`/blog/${post.id}`}
                  class="group flex h-full min-h-72 flex-col border-2 border-transparent p-8 md:p-10 transition-colors duration-200 hover:border-primary focus-visible:outline focus-visible:outline-4 focus-visible:outline-offset-4 focus-visible:outline-interactive"
                >
                  <p class="text-xs font-bold uppercase tracking-label text-secondary mb-4">
                    {formatDate(post.data.publishDate)}
                  </p>
                  <h2 class="font-heading text-2xl md:text-3xl font-extrabold tracking-tight leading-tight text-secondary text-balance mb-4">
                    {post.data.title}
                  </h2>
                  <p class="text-neutral-900 leading-relaxed">{post.data.description}</p>
                  <span class="mt-auto pt-8 inline-flex items-center gap-3 text-xs font-extrabold uppercase tracking-label text-neutral-900 after:block after:h-0.5 after:w-6 after:bg-current after:transition-all after:duration-200 group-hover:after:w-14">
                    Leer artículo
                  </span>
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </section>
</BaseLayout>
