---
export const prerender = true;

import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('blog')).sort(
  (a: CollectionEntry<'blog'>, b: CollectionEntry<'blog'>) =>
    b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
);

function formatDate(date: Date): string {
  return date.toLocaleDateString('es-CO', { year: 'numeric', month: 'long', day: 'numeric' });
}
---

<BaseLayout
  title="Blog"
  description="Artículos sobre desarrollo de software a la medida, modernización de sistemas y buenas prácticas de TI para empresas."
>
  <header
    class="bg-secondary text-white py-24 md:py-32 px-4 md:px-8 border-b-8 border-accent"
  >
    <div class="max-w-7xl mx-auto">
      <h1 class="text-4xl md:text-6xl font-heading mb-6 tracking-tight text-white">Blog</h1>
      <p class="text-xl md:text-2xl text-neutral-300 max-w-3xl leading-relaxed">
        Ideas y prácticas reales sobre desarrollo de software, modernización de sistemas y TI para
        empresas.
      </p>
    </div>
  </header>

  <section class="py-24 px-4 md:px-8 bg-neutral-50">
    <div class="max-w-7xl mx-auto">
      {
        posts.length === 0 ? (
          <div class="text-center py-24 border-2 border-dashed border-neutral-200">
            <p class="text-lg text-neutral-600 max-w-xl mx-auto">
              Todavía no hay artículos publicados. Estamos preparando el primer contenido —{' '}
              <a href="/contacto" class="text-interactive font-bold underline">
                escríbenos
              </a>{' '}
              si quieres que cubramos un tema puntual.
            </p>
          </div>
        ) : (
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {posts.map((post: CollectionEntry<'blog'>) => (
              <a
                href={`/blog/${post.id}`}
                class="block border-2 border-neutral-200 bg-white p-8 hover:border-primary transition-colors duration-300"
              >
                <p class="text-xs font-bold uppercase tracking-widest text-interactive mb-2">
                  {formatDate(post.data.publishDate)}
                </p>
                <h2 class="text-2xl font-heading text-secondary mb-4 leading-tight">
                  {post.data.title}
                </h2>
                <p class="text-neutral-900 leading-relaxed">{post.data.description}</p>
              </a>
            ))}
          </div>
        )
      }
    </div>
  </section>
</BaseLayout>
