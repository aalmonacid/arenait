---
export const prerender = true;

import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Button from '../../components/Button.astro';
import { getPosts, getSiteSettings } from '../../lib/content';
import { renderBody } from '../../lib/renderBody';
import { formatLongDate } from '../../lib/contentRules';
import { imageDimensions } from '../../lib/portableText';
import { urlForImage } from '../../lib/imageBuilder';
import { absoluteUrl, blogPostingSchema, breadcrumbSchema } from '../../lib/structuredData';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { slug: post.slug.current },
    props: { post },
  }));
}

const { post } = Astro.props;
const settings = await getSiteSettings();
const bodyHtml = renderBody(post.body);

const tags = post.tags ?? [];
const kicker = tags.length > 0 ? tags.join(' · ') : 'Blog';
const byline = `${formatLongDate(post.publishDate)}${post.author ? ` · ${post.author}` : ''}`;

// Portada (opcional): requiere texto alternativo y una referencia de imagen válida.
const coverSize = imageDimensions(post.coverImage?.asset?._ref);
const cover =
  post.coverImage?.alt?.trim() && coverSize
    ? {
        alt: post.coverImage.alt.trim(),
        width: Math.min(coverSize.width, 1200),
        height: Math.round((coverSize.height * Math.min(coverSize.width, 1200)) / coverSize.width),
        src: urlForImage(post.coverImage).width(Math.min(coverSize.width, 1200)).url(),
      }
    : undefined;

const siteOrigin = new URL('/', Astro.site).toString().replace(/\/$/, '');
const postUrl = absoluteUrl(siteOrigin, `/blog/${post.slug.current}`);
const structuredData = [
  blogPostingSchema({
    headline: post.title,
    description: post.description,
    datePublished: post.publishDate,
    authorName: post.author,
    publisherName: settings.siteName,
    publisherUrl: siteOrigin,
    url: postUrl,
    image: cover?.src,
  }),
  breadcrumbSchema([
    { name: 'Inicio', url: absoluteUrl(siteOrigin, '/') },
    { name: 'Blog', url: absoluteUrl(siteOrigin, '/blog') },
    { name: post.title, url: postUrl },
  ]),
];
---

<BaseLayout
  title={post.title}
  description={post.description}
  ogType="article"
  ogImage={cover?.src}
  structuredData={structuredData}
>
  <article class="bg-white">
    <PageHero kicker={kicker} title={post.title} lead={byline} />

    <section class="py-16 md:py-24 px-4 md:px-8">
      <div class="max-w-3xl mx-auto markdown-content">
        {
          cover && (
            <figure>
              <img
                src={cover.src}
                alt={cover.alt}
                width={cover.width}
                height={cover.height}
                decoding="async"
              />
            </figure>
          )
        }
        <Fragment set:html={bodyHtml} />
      </div>
    </section>

    <section class="py-14 px-4 md:px-8 bg-neutral-50 border-t border-neutral-200">
      <div
        class="max-w-3xl mx-auto flex flex-col sm:flex-row sm:items-center sm:justify-between gap-6"
      >
        <a
          href="/blog"
          class="w-fit border-b-2 border-neutral-900 py-1 text-xs font-extrabold uppercase tracking-label text-neutral-900 hover:border-interactive"
        >
          ← Ver todos los artículos
        </a>
        <Button href="/contacto">Cuéntanos tu reto</Button>
      </div>
    </section>
  </article>
</BaseLayout>
