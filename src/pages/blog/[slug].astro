---
export const prerender = true;

import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Button from '../../components/Button.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');

  return posts.map((post: CollectionEntry<'blog'>) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

function formatDate(date: Date): string {
  return date.toLocaleDateString('es-CO', { year: 'numeric', month: 'long', day: 'numeric' });
}

const kicker = post.data.tags.length > 0 ? post.data.tags.join(' · ') : 'Blog';
const byline = `${formatDate(post.data.publishDate)}${post.data.author ? ` · ${post.data.author}` : ''}`;
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <article class="bg-white">
    <PageHero kicker={kicker} title={post.data.title} lead={byline} />

    <section class="py-16 md:py-24 px-4 md:px-8">
      <div class="max-w-3xl mx-auto markdown-content">
        <Content />
      </div>
    </section>

    <section class="py-14 px-4 md:px-8 bg-neutral-50 border-t border-neutral-200">
      <div
        class="max-w-3xl mx-auto flex flex-col sm:flex-row sm:items-center sm:justify-between gap-6"
      >
        <a
          href="/blog"
          class="w-fit border-b-2 border-neutral-900 py-1 text-xs font-extrabold uppercase tracking-label text-neutral-900 hover:border-interactive"
        >
          ← Ver todos los artículos
        </a>
        <Button href="/contacto">Cuéntanos tu reto</Button>
      </div>
    </section>
  </article>
</BaseLayout>
