---
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 — Ruta no encontrada">
  <div class="min-h-screen bg-secondary flex items-center justify-center p-4 text-center">
    <div>
      <h1 class="text-3xl md:text-5xl font-heading text-white mb-8 uppercase tracking-tight">
        404 — Ruta fuera de los parámetros de arquitectura
      </h1>
      <a
        href="/"
        class="inline-block px-8 py-4 bg-primary text-white font-bold tracking-widest uppercase hover:bg-interactive transition-colors"
      >
        Retornar al inicio
      </a>
    </div>
  </div>
</BaseLayout>
