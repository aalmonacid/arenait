---
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import DotsMotif from '../components/DotsMotif.astro';
---

<BaseLayout title="404 — Página no encontrada">
  <section class="bg-white px-4 md:px-8 py-24 md:py-40">
    <div class="max-w-7xl mx-auto">
      <p
        class="flex items-center gap-4 text-xs font-bold uppercase tracking-label text-secondary mb-6 before:block before:h-0.5 before:w-12 before:bg-neutral-900"
      >
        Error 404
      </p>
      <h1 class="font-heading text-display max-w-display text-neutral-900 mb-8">
        404 — Página no encontrada
      </h1>
      <p class="text-lead text-neutral-900 max-w-xl mb-10">
        La dirección que buscas no existe o cambió de lugar. Vuelve al inicio y retoma desde ahí.
      </p>
      <div class="flex flex-col sm:flex-row sm:items-center gap-8">
        <Button href="/">Volver al inicio</Button>
        <DotsMotif />
      </div>
    </div>
  </section>
</BaseLayout>
