---
export const prerender = true;

import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import LeadCaptureForm from '../../components/LeadCaptureForm.astro';
import { getSiteSettings } from '../../lib/content';
import { buildWhatsappUrl } from '../../lib/contact';

const settings = await getSiteSettings();
const WHATSAPP_URL = buildWhatsappUrl(settings.whatsappNumber, settings.whatsappMessage);
---

<BaseLayout
  title="Hablemos de tu proyecto"
  description="Cuéntanos tu reto. Te respondemos con una propuesta concreta."
  ogImage="/og-contacto.jpg"
>
  <PageHero
    kicker="Contacto"
    title="Hablemos de tu proyecto"
    lead="Te respondemos con una propuesta concreta."
  />

  <section class="py-16 md:py-24 px-4 md:px-8 bg-neutral-50">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-x-6 gap-y-12 items-start">
      <div class="lg:col-span-4 border-t-2 border-neutral-900 pt-5">
        <h2 class="text-xs font-bold uppercase tracking-label text-secondary mb-3">Contacto</h2>
        <p class="font-heading text-2xl font-extrabold tracking-tight text-secondary">
          {settings.managerName} · {settings.managerRole}
        </p>
        <p class="mt-4 text-neutral-900 leading-relaxed">
          ¿Prefieres escribir directo? Hazlo por{' '}
          <a
            href={WHATSAPP_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="font-bold text-secondary underline decoration-interactive decoration-2 underline-offset-4"
            >WhatsApp</a
          >.
        </p>

        <h2 class="mt-10 mb-3 text-xs font-bold uppercase tracking-label text-secondary">
          Qué pasa después
        </h2>
        <ol class="list-decimal pl-5 space-y-2 text-neutral-900">
          <li>Revisamos lo que nos cuentas sobre tu operación.</li>
          <li>Te escribimos con una propuesta concreta.</li>
          <li>Definimos juntos los siguientes pasos.</li>
        </ol>
      </div>
      <div class="lg:col-span-8">
        <LeadCaptureForm showServiceDropdown />
      </div>
    </div>
  </section>
</BaseLayout>
