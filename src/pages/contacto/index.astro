---
export const prerender = true;

import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import LeadCaptureForm from '../../components/LeadCaptureForm.astro';
import { getServices } from '../../lib/services';

// El desplegable "Servicio de interés" usa los mismos servicios del sitio (panel
// de Sanity con respaldo en el código), para que siga al día si el cliente
// renombra, agrega o elimina servicios.
const services = (await getServices()).map((s) => ({ title: s.title }));
---

<BaseLayout
  title="Hablemos de tu proyecto"
  description="Cuéntanos tu reto. Te respondemos con una propuesta concreta."
>
  <PageHero kicker="Contacto" title="Hablemos de tu proyecto" lead="Cuéntanos tu reto." />

  <section class="py-16 md:py-24 px-4 md:px-8 bg-neutral-50">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-x-6 gap-y-12 items-start">
      <div class="lg:col-span-4 border-t-2 border-neutral-900 pt-5">
        <h2 class="text-xs font-bold uppercase tracking-label text-secondary mb-3">Contacto</h2>
        <p class="font-heading text-2xl font-extrabold tracking-tight text-secondary">
          Andrés Arenas — Gerente
        </p>
      </div>
      <div class="lg:col-span-8">
        <LeadCaptureForm showServiceDropdown services={services} />
      </div>
    </div>
  </section>
</BaseLayout>
