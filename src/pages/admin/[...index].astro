---
export const prerender = true;

// Se delega la renderización a un wrapper estricto de React para aislar Vite SSR
import SanityStudio from '../../components/SanityStudio';

// Generamos la ruta estática base para el SPA
export function getStaticPaths() {
  return [{ params: { index: undefined } }, { params: { index: 'structure' } }];
}
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>Sanity Studio | ArenaIT</title>
    <style>
      body {
        margin: 0;
        padding: 0;
        height: 100vh;
        max-height: 100dvh;
        overflow: hidden;
        overscroll-behavior: none;
        -webkit-font-smoothing: antialiased;
        background-color: #294e6c;
      }
    </style>
  </head>
  <body>
    <div data-ui="AstroStudioLayout">
      <SanityStudio client:only="react" />
    </div>
  </body>
</html>
