---
// Se renderiza en el Worker (no estático) para que cualquier ruta interna del
// Studio (/admin/structure/service...) cargue al refrescar la página.
export const prerender = false;

// Se delega la renderización a un wrapper estricto de React para aislar Vite SSR
import SanityStudio from '../../components/SanityStudio';

---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>Sanity Studio | ArenaIT</title>
    <style>
      html,
      body {
        height: 100%;
      }
      body {
        margin: 0;
        padding: 0;
        height: 100vh;
        max-height: 100dvh;
        overflow: hidden;
        overscroll-behavior: none;
        -webkit-font-smoothing: antialiased;
        background-color: #294e6c;
      }
      /* El Studio mide el 100% de su contenedor. Sin altura propia en este
         contenedor, se encogía al alto de su contenido (~370px) y el resto de
         la ventana mostraba el fondo azul del body, sin poder navegar. */
      [data-ui='AstroStudioLayout'] {
        height: 100vh;
        max-height: 100dvh;
        overflow: auto;
      }
    </style>
  </head>
  <body>
    <div data-ui="AstroStudioLayout">
      <SanityStudio client:only="react" />
    </div>
  </body>
</html>
