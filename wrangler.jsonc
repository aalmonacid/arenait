{
  // Worker de ArenaIT en Cloudflare: sirve los archivos estáticos (páginas
  // prerenderizadas) y ejecuta /api/leads. Los secretos NO van aquí: se cargan
  // en el panel de Cloudflare o con `wrangler secret put` (ver GUIA-HABILITACION.md).
  "name": "arenait",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  // Solo se accede por el dominio propio. Sin esto Cloudflare publica además
  // arenait.<cuenta>.workers.dev y URLs de vista previa que sirven /api/leads y
  // /admin fuera de la zona (sin la regla de rate limiting del WAF).
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "html_handling": "drop-trailing-slash"
  },
  "observability": { "enabled": true }
}
