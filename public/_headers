# Cabeceras para los archivos estáticos (páginas, fuentes, scripts).
# Las respuestas del Worker (/api/*, /admin) NO pasan por este archivo: sus
# cabeceras las fija src/middleware.ts.
# HSTS sin includeSubDomains ni preload hasta inventariar los subdominios del dominio definitivo.
/*
  Strict-Transport-Security: max-age=31536000
  Cross-Origin-Opener-Policy: same-origin
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' https://challenges.cloudflare.com; style-src 'self'; font-src 'self'; img-src 'self' https://cdn.sanity.io data:; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; frame-src https://challenges.cloudflare.com; object-src 'none'; upgrade-insecure-requests

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Sin efecto hoy: /admin lo responde el Worker (ver src/middleware.ts). Se deja
# por si algún día el Studio se sirviera como archivo estático.
/admin
  ! Content-Security-Policy
/admin/*
  ! Content-Security-Policy
